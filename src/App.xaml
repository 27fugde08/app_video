<Application x:Class="CreatorOS.Desktop.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CreatorOS.Desktop.Wpf"
             xmlns:converters="clr-namespace:CreatorOS.Desktop.Wpf.Converters"
             xmlns:viewmodels="clr-namespace:CreatorOS.Desktop.Wpf.ViewModels"
             xmlns:views="clr-namespace:CreatorOS.Desktop.Wpf.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

            <!-- Backward Compatibility Resource Aliases -->
            <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="{StaticResource ColorObsidianBase}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource ColorCardSurface}" />

            <!-- Global View-ViewModel MVVM DataTemplates -->
            <DataTemplate DataType="{x:Type viewmodels:BatchDownloadViewModel}">
                <views:BatchDownloadView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:DownloadBatchViewModel}">
                <views:BatchDownloadView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:DubbingViewModel}">
                <views:DubbingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:TimelineEditorViewModel}">
                <views:TimelineEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:VoiceStudioViewModel}">
                <views:VoiceStudioView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:LipSyncViewModel}">
                <views:LipSyncView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:ThumbnailSeoViewModel}">
                <views:ThumbnailSeoView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:ContentIdShieldViewModel}">
                <views:ContentIdShieldView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:PublisherViewModel}">
                <views:PublisherView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:JobQueueViewModel}">
                <views:JobQueueListView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
