<UserControl x:Class="CreatorOS.Desktop.Wpf.Views.ThumbnailSeoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:CreatorOS.Desktop.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1180"
             Background="#0F172A">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Top Controls Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area: Left 3D Canvas / Right Gemini SEO Suite -->
            <RowDefinition Height="*"/>
            <!-- Bottom Export & Status -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Controls Bar -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🎬 TỆP VIDEO NGUỒN:" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding VideoSourcePath, UpdateSourceTrigger=PropertyChanged}" 
                         Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1"
                         Padding="8,5" FontSize="11" VerticalContentAlignment="Center"/>

                <Button Grid.Column="2" Content="⚡ Tự Động Tạo Thumbnail 3D &amp; SEO" Command="{Binding AutoGenerateThumbnailAndSeoCommand}"
                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                        BorderThickness="0" Padding="16,6" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: 3D Layer Canvas & Preset Gallery -->
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="12"/>
                <!-- Right: Gemini SEO Suite & Metadata Optimizer -->
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: 3D Thumbnail Composer Canvas -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🎨 Khung Dựng Bìa 3D Xuyên Lớp (Layer Sandwich)" Foreground="#38BDF8" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="Tỷ lệ 16:9 (1920x1080)" Foreground="#64748B" FontSize="11"/>
                    </Grid>

                    <!-- 3D Canvas Preview -->
                    <Border Grid.Row="1" Background="#020617" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <!-- Layer 1: Blurred Background -->
                            <TextBlock Text="[Lớp 1: Background Blur 10px &amp; Contrast Boost]" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- Layer 2: 3D Behind-Subject Text -->
                            <TextBlock Text="{Binding CustomHookText}" 
                                       Foreground="#FACC15" FontSize="46" FontWeight="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-40,0,0">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="{Binding TextRotationAngle}"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>

                            <!-- Layer 3: Foreground Subject with Rim Light -->
                            <Border BorderBrush="#38BDF8" BorderThickness="2" CornerRadius="4" Width="180" Height="260" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                <TextBlock Text="[Lớp 3: Chủ Thể Tách Nền RMBG-1.4 + Rim Glow]" Foreground="#38BDF8" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                            </Border>

                            <!-- Layer 4: 4K Badge Overlay -->
                            <Border Background="#DC2626" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14">
                                <TextBlock Text="4K HDR" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Preset Gallery (3 AI Variants) -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="🖼️ 3 Bản Mẫu AI Đã Tạo (Nhấp để chọn):" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,6"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding PresetGallery}" SelectedItem="{Binding SelectedPreset}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Padding="10,6" Margin="0,0,10,0" Width="170">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock Text="{Binding HookText}" Foreground="#FBBF24" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: Gemini SEO Suite -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- SEO Score Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🚀 Tối Ưu Hóa SEO (Gemini High-CTR)" Foreground="#34D399" FontWeight="Bold" FontSize="13"/>
                        <Border Grid.Column="1" Background="#10B981" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{Binding SeoScore, StringFormat='{}SEO: {0}/100'}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                        </Border>
                    </Grid>

                    <!-- Title Selector -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tiêu đề gợi ý (5 Biến Thể A/B Test):" Foreground="#94A3B8" FontSize="11"/>
                            <Button Grid.Column="1" Content="📋 Copy Title" Command="{Binding CopyTitleToClipboardCommand}" Background="#334155" Foreground="#38BDF8" FontSize="10" Padding="6,2" BorderThickness="0"/>
                        </Grid>
                        <ComboBox ItemsSource="{Binding TitleVariants}" SelectedItem="{Binding SelectedTitle}" 
                                  Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569" Padding="6,4" FontSize="11"/>
                    </StackPanel>

                    <!-- Description & Chapters Box -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mô tả chuẩn SEO kèm Video Chapters:" Foreground="#94A3B8" FontSize="11"/>
                            <Button Grid.Column="1" Content="📋 Copy Mô Tả" Command="{Binding CopyDescriptionToClipboardCommand}" Background="#334155" Foreground="#38BDF8" FontSize="10" Padding="6,2" BorderThickness="0"/>
                        </Grid>
                        <TextBox Grid.Row="1" Text="{Binding VideoDescription}" 
                                 Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1"
                                 Padding="8" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </Grid>

                    <!-- SEO Tags Box -->
                    <StackPanel Grid.Row="3">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="25+ Thẻ Tag YouTube (Comma-Separated):" Foreground="#94A3B8" FontSize="11"/>
                            <Button Grid.Column="1" Content="📋 Copy Tags" Command="{Binding CopyTagsToClipboardCommand}" Background="#334155" Foreground="#38BDF8" FontSize="10" Padding="6,2" BorderThickness="0"/>
                        </Grid>
                        <TextBox Text="{Binding SeoTags}" 
                                 Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1"
                                 Padding="6" FontSize="10" Height="45" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Export & Status -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,12,0,0" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="6" Width="380" HorizontalAlignment="Left"
                                 Background="#334155" Foreground="#10B981" BorderThickness="0"
                                 Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="💾 Lưu Ảnh Bìa 3D HD (1920x1080)" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold"
                        FontSize="13" BorderThickness="0" Padding="18,8"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
