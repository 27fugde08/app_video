<UserControl x:Class="CreatorOS.Desktop.Wpf.Views.DubbingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:CreatorOS.Desktop.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1440"
             Background="#0B0D13"
             Foreground="#F8FAFC"
             FontFamily="Segoe UI, Inter, -apple-system">

    <UserControl.DataContext>
        <viewmodels:DubbingViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Standard Converters -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Dark Slate Workstation Resource Styles -->
        <SolidColorBrush x:Key="BorderDarkBrush" Color="#282F44"/>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#131722"/>
        <SolidColorBrush x:Key="SubPanelBgBrush" Color="#0B0D13"/>
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#06B6D4"/>
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="DangerRedBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B"/>

        <!-- Custom ScrollBar Styling -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0B0D13"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Red Action Button Style -->
        <Style x:Key="RedActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Rotary Knob Style Template -->
        <Style x:Key="RotaryKnobContainer" TargetType="Border">
            <Setter Property="Background" Value="#0B0D13"/>
            <Setter Property="BorderBrush" Value="#282F44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <!-- Main 3-Column Layout: Left (300px) | Splitter | Center (*) | Splitter | Right (450px) -->
        <Grid.ColumnDefinitions>
            <!-- Cột Trái - Bộ Quản Lý Thư Mục Nguồn (300px) -->
            <ColumnDefinition Width="300" MinWidth="260" MaxWidth="360"/>
            <!-- Splitter 1 -->
            <ColumnDefinition Width="6"/>
            <!-- Cột Giữa - Khung Trình Chiếu Kép D3D11 (Flexible) -->
            <ColumnDefinition Width="*" MinWidth="480"/>
            <!-- Splitter 2 -->
            <ColumnDefinition Width="6"/>
            <!-- Cột Phải - Bảng Soát Thoại & Điều Phối Âm Nhịp (450px) -->
            <ColumnDefinition Width="450" MinWidth="380" MaxWidth="560"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================================= -->
        <!-- CỘT TRÁI - BỘ QUẢN LÝ THƯ MỤC NGUỒN (RỘNG 300PX) -->
        <!-- ========================================================================= -->
        <Border Grid.Column="0" Background="#131722" BorderBrush="#282F44" BorderThickness="1" CornerRadius="12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header with Badge -->
                    <RowDefinition Height="Auto"/>
                    <!-- Sync Action Button -->
                    <RowDefinition Height="Auto"/>
                    <!-- Filter Checkbox -->
                    <RowDefinition Height="Auto"/>
                    <!-- Scanned Folders Table -->
                    <RowDefinition Height="*"/>
                    <!-- Footer Storage Info -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header: Tiêu đề + Badge -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="📁 THƯ MỤC NGUỒN" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <TextBlock Text="Danh Sách Video Đã Quét" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                    </StackPanel>

                    <!-- Badge hiển thị số lượng video khả dụng -->
                    <Border Grid.Column="1" Background="#06B6D4" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AvailableVideoCount, StringFormat='{}{0} Videos'}" 
                                   Foreground="#0B0D13" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <!-- 2. Conveyor Control Header & Actions -->
                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,10">
                    <!-- Checkbox Chế độ Băng Chuyền Toàn Cục -->
                    <Border Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,8">
                        <CheckBox IsChecked="{Binding IsConveyorModeEnabled, Mode=TwoWay}"
                                  Foreground="#E0E7FF" FontSize="11" FontWeight="SemiBold" VerticalContentAlignment="Center" Cursor="Hand">
                            <TextBlock Text="⚡ Băng chuyền: Tự động lồng tiếng khi tải xong" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </CheckBox>
                    </Border>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Nút Bấm "Đồng Bộ Video Vừa Tải" -->
                        <Button Grid.Column="0" Command="{Binding SyncDownloadedVideosCommand}"
                                Background="#7C3AED" Foreground="#FFFFFF" BorderThickness="0"
                                Padding="8,6" Margin="0,0,4,0" Cursor="Hand" FontWeight="Bold" FontSize="11">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="M 12 4 A 8 8 0 0 1 20 12 L 17.5 12 L 21 16 L 24.5 12 L 22 12 A 10 10 0 0 0 12 2 A 10 10 0 0 0 2 12 A 10 10 0 0 0 5 19.1 L 6.4 17.7 A 8 8 0 0 1 4 12 A 8 8 0 0 1 12 4 Z" 
                                                  Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Đồng Bộ Vừa Tải" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nút "Tạm Dừng Luồng AI" -->
                        <Button Grid.Column="1" Command="{Binding ToggleAiPipelinePauseCommand}"
                                Foreground="#F1F5F9" BorderThickness="0"
                                Padding="8,6" Cursor="Hand" FontWeight="SemiBold" FontSize="11">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#334155"/>
                                    <Setter Property="Content" Value="Tạm dừng AI"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAiPipelinePaused}" Value="True">
                                            <Setter Property="Background" Value="#EAB308"/>
                                            <Setter Property="Foreground" Value="#000000"/>
                                            <Setter Property="Content" Value="▶ Tiếp tục AI"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- 3. GPU Throttle Status & Filter -->
                <Border Grid.Row="2" Background="#0B0D13" BorderBrush="#282F44" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                    <StackPanel Orientation="Vertical">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="VRAM Adapter (DXGI):" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding GpuVramUsagePercent, StringFormat='{}{0:F1}% (Ổn định)'}" 
                                       FontSize="10" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                        </Grid>
                        <CheckBox IsChecked="{Binding IgnoreCompletedVideos, Mode=TwoWay}"
                                  Foreground="#CBD5E1" FontSize="10" VerticalContentAlignment="Center" Cursor="Hand">
                            <TextBlock Text="Bỏ qua video đã hoàn thành" VerticalAlignment="Center"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- 4. Danh Sách Video Băng Chuyền với Huy Hiệu Tiến Trình Động (Dynamic Badges) -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <!-- Table Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Table Items List -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header Row -->
                    <Border Grid.Row="0" Background="#0B0D13" BorderBrush="#282F44" BorderThickness="1" CornerRadius="6,6,0,0" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" TextAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="VIDEO / TRẠNG THÁI" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock Grid.Column="2" Text="TIẾN TRÌNH" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Table Virtualizing Items List -->
                    <Border Grid.Row="1" Background="#0B0D13" BorderBrush="#282F44" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding PipelineVideos}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1E2332" BorderThickness="0,0,0,1" Padding="8,7">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#1E293B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Cột 1: STT -->
                                                <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="10" Foreground="#64748B" 
                                                           VerticalAlignment="Center" TextAlignment="Center" FontFamily="Consolas"/>

                                                <!-- Cột 2: Tên Video & Badge Động -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,4,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" 
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                    
                                                    <!-- Dynamic Badge: 6 Giai Đoạn Động -->
                                                    <Border Margin="0,3,0,0" HorizontalAlignment="Left" CornerRadius="4" Padding="5,2"
                                                            Background="{Binding BadgeBgColor}">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding BadgeColor}"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Cột 3: Nút Mở File hoặc Thanh Tiến Trình -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <!-- Nút Mở File khi Hoàn Thành -->
                                                    <Button Content="Mở file" Style="{StaticResource RedActionButtonStyle}"
                                                            Background="#059669"
                                                            Visibility="{Binding CanOpenFile, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                                            Command="{Binding DataContext.OpenVideoFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding FilePath}"
                                                            Padding="6,3" FontSize="10" Margin="0,0,2,0"/>

                                                    <!-- Nút Chọn Video để Soát Thoại -->
                                                    <Button Content="Chọn" Style="{StaticResource RedActionButtonStyle}"
                                                            Command="{Binding DataContext.SelectPipelineVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="6,3" FontSize="10"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 5. Footer Status -->
                <Border Grid.Row="4" Background="#0B0D13" CornerRadius="6" Padding="8,6" Margin="0,10,0,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>
        </Border>

        <!-- Grid Splitter 1 -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

        <!-- ========================================================================= -->
        <!-- CỘT GIỮA - KHUNG TRÌNH CHIẾU KÉP D3D11 (DUAL-PREVIEW CANVAS) -->
        <!-- ========================================================================= -->
        <Border Grid.Column="2" Background="#131722" BorderBrush="#282F44" BorderThickness="1" CornerRadius="12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Dual Player Header & Metadata -->
                    <RowDefinition Height="Auto"/>
                    <!-- Dual Screen Side-By-Side Canvas -->
                    <RowDefinition Height="*"/>
                    <!-- Subtitle Overlay Container -->
                    <RowDefinition Height="Auto"/>
                    <!-- Timeline Scrubber & Controls -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Dual View Header with Workflow Preset Selector -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎬 D3D11 DUAL-PREVIEW WORKSTATION" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Text=" • 60 FPS DirectComposition Hardware Swaps" FontSize="10" Foreground="#64748B" Margin="8,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Background="#10B981" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="ZERO COPY NVDEC" FontSize="9" FontWeight="Bold" Foreground="#0B0D13"/>
                            </Border>
                            <Border Background="#7C3AED" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="SIDE-BY-SIDE SYNC" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Workflow Preset Selector Bar (Standard, Cinema Recap, Comic Manga) -->
                    <Border Grid.Row="1" Background="#0B0D13" BorderBrush="#282F44" BorderThickness="1" CornerRadius="8" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="⚡ KỊCH BẢN PRESET:" FontSize="10" FontWeight="Bold" Foreground="#06B6D4" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            </StackPanel>

                            <!-- Preset Dropdown Selector -->
                            <ComboBox Grid.Column="1" 
                                      ItemsSource="{Binding AvailablePresets}" 
                                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                      Background="#1E293B" 
                                      Foreground="#F8FAFC" 
                                      BorderBrush="#6366F1" 
                                      FontSize="11" 
                                      FontWeight="SemiBold"
                                      Padding="6,4"
                                      Height="28"
                                      VerticalContentAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,8,0"/>
                                            <Border Background="{Binding BadgeBgColor}" CornerRadius="3" Padding="4,1">
                                                <TextBlock Text="{Binding Badge}" FontSize="8" FontWeight="Bold" Foreground="{Binding BadgeColor}"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Preset Quick Details Badge -->
                            <Border Grid.Column="2" Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="8,0,0,0">
                                <TextBlock Text="{Binding SelectedPreset.Badge, FallbackValue='ĐỐI THOẠI CHUẨN'}" FontSize="9" FontWeight="Bold" Foreground="#A5B4FC" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Màn Hình Chia Đôi Đặt Cạnh Nhau (Side-by-side): Gốc vs Lồng Tiếng Mới -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <!-- Nửa trái: Video Gốc (Original) -->
                        <ColumnDefinition Width="*"/>
                        <!-- Split divider -->
                        <ColumnDefinition Width="4"/>
                        <!-- Nửa phải: Video Đã Ghép Giọng & Phụ Đề Mới (Dubbed) -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Video Gốc (Original) -->
                    <Border Grid.Column="0" Background="#0B0D13" BorderBrush="#282F44" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <!-- Simulated D3D11 Viewport View -->
                            <Rectangle Fill="#1E2332"/>
                            
                            <!-- Video Simulation Visual -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🎥 VIDEO GỐC (ORIGINAL)" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBlock Text="Audio: English Clean Speech (Stem 1)" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <Border Background="#334155" CornerRadius="4" Padding="8,4" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="1080p 60fps • Native Video Track" FontSize="9" Foreground="#E2E8F0" FontFamily="Consolas"/>
                                </Border>
                            </StackPanel>

                            <!-- Watermark / Tag -->
                            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#000000" Opacity="0.7" CornerRadius="4" Padding="6,2" Margin="8">
                                <TextBlock Text="Nguồn: TikTok Raw (No Watermark)" FontSize="9" Foreground="#CBD5E1"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Split Line -->
                    <Border Grid.Column="1" Background="#282F44" Width="2" HorizontalAlignment="Center"/>

                    <!-- Right: Video Đã Ghép Giọng & Phụ Đề Mới (Dubbed) -->
                    <Border Grid.Column="2" Background="#0B0D13" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <!-- Simulated D3D11 Viewport View -->
                            <Rectangle Fill="#131722"/>

                            <!-- Video Simulation Visual -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🎙️ VIDEO LỒNG TIẾNG (DUBBED VI)" FontSize="12" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Center"/>
                                <TextBlock Text="Voice: Hoài My Neural (1.0x Rate)" FontSize="10" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <Border Background="#4C1D95" CornerRadius="4" Padding="8,4" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="Sidechain Ducking: -14dB Active" FontSize="9" Foreground="#F5D0FE" FontFamily="Consolas"/>
                                </Border>
                            </StackPanel>

                            <!-- Subtitle Overlay on Dubbed Preview -->
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#CC0B0D13" CornerRadius="6" Padding="12,6" Margin="12,0,12,12">
                                <TextBlock Text="{Binding CurrentSubtitleText}" FontSize="12" FontWeight="Bold" Foreground="#FDE047" 
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
                            </Border>

                            <!-- Tag -->
                            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#7C3AED" CornerRadius="4" Padding="6,2" Margin="8">
                                <TextBlock Text="Lồng Tiếng AI + Phụ Đề Mới" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Thước Thời Gian Timeline Scrubber ở Đáy -->
                <Border Grid.Row="3" Background="#0B0D13" BorderBrush="#282F44" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Audio Waveform Graphic -->
                            <RowDefinition Height="28"/>
                            <!-- Scrubber Slider -->
                            <RowDefinition Height="Auto"/>
                            <!-- Playback Control Buttons & Time Codes -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Simulated Vector Audio Waveform -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Rectangle Fill="#1E2332" RadiusX="4" RadiusY="4"/>
                            <!-- Waveform Bars -->
                            <Path Data="M 0 14 L 20 6 L 40 22 L 60 4 L 80 24 L 100 8 L 120 20 L 140 2 L 160 26 L 180 10 L 200 18 L 220 5 L 240 23 L 260 9 L 280 19 L 300 3 L 320 25 L 340 7 L 360 21 L 380 6 L 400 22 L 420 8 L 440 20 L 460 14"
                                  Stroke="#06B6D4" StrokeThickness="1.5" Stretch="Fill" VerticalAlignment="Center"/>
                            
                            <!-- Highlight Selected Script Line Segment -->
                            <Border Background="#7C3AED" Opacity="0.35" HorizontalAlignment="Left" Width="120" Margin="80,0,0,0"/>
                        </Grid>

                        <!-- 60 FPS Scrubber Slider -->
                        <Slider Grid.Row="1" Minimum="0" Maximum="{Binding TotalDurationSec}" 
                                Value="{Binding CurrentPositionSec, Mode=TwoWay}"
                                Foreground="#7C3AED" Background="#282F44" Cursor="Hand" Margin="0,0,0,8"/>

                        <!-- Playback Controls: Play/Pause/Loop + Timecodes -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Control Buttons -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <!-- Step Back 5s -->
                                <Button Command="{Binding StepBack5SecCommand}" Background="#1E2332" Foreground="#CBD5E1" 
                                        BorderThickness="0" Padding="8,4" CornerRadius="4" Margin="0,0,4,0" Content="⏪ -5s" FontSize="11" Cursor="Hand"/>
                                
                                <!-- Play/Pause Button -->
                                <Button Command="{Binding TogglePlayPauseCommand}" Background="#7C3AED" Foreground="#FFFFFF" 
                                        BorderThickness="0" Padding="14,4" CornerRadius="4" Margin="0,0,4,0" FontWeight="Bold" FontSize="11" Cursor="Hand">
                                    <TextBlock Text="{Binding IsPlaying, Converter={x:Null}, FallbackValue='▶ Phát'}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Text" Value="⏸ Tạm Dừng"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                                                        <Setter Property="Text" Value="▶ Phát"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>

                                <!-- Step Forward 5s -->
                                <Button Command="{Binding StepForward5SecCommand}" Background="#1E2332" Foreground="#CBD5E1" 
                                        BorderThickness="0" Padding="8,4" CornerRadius="4" Margin="0,0,6,0" Content="+5s ⏩" FontSize="11" Cursor="Hand"/>

                                <!-- Loop Button -->
                                <ToggleButton IsChecked="{Binding IsLooping, Mode=TwoWay}" Background="#1E2332" Foreground="#F8FAFC" 
                                              BorderThickness="0" Padding="8,4" Margin="0,0,4,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔁 Lặp Câu Thoại" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>

                            <!-- Right Timecode Displays (Monospace) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentTimeFormatted}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" FontFamily="Consolas"/>
                                <TextBlock Text=" / " FontSize="12" Foreground="#64748B" FontFamily="Consolas"/>
                                <TextBlock Text="{Binding TotalTimeFormatted}" FontSize="12" Foreground="#94A3B8" FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Grid Splitter 2 -->
        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

        <!-- ========================================================================= -->
        <!-- CỘT PHẢI - BẢNG SOÁT THOẠI, PHÂN VAI, TỪ ĐIỂN & TRỘN ÂM ĐA KÊNH (RỘNG 450PX) -->
        <!-- ========================================================================= -->
        <Border Grid.Column="4" Background="#131722" BorderBrush="#282F44" BorderThickness="1" CornerRadius="12" Padding="12">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="TabBorder" Background="#0B0D13" BorderBrush="#282F44" BorderThickness="1,1,1,0" 
                                            CornerRadius="6,6,0,0" Margin="0,0,3,0" Padding="8,5" Cursor="Hand">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#1E293B"/>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#7C3AED"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#1E2332"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: KỊCH BẢN & KHÓA ÂM TIẾT -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎙️ Kịch Bản" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <Border Background="#3B82F6" CornerRadius="8" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ScriptLines.Count, FallbackValue='150'}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <!-- Top Action Bar -->
                            <RowDefinition Height="Auto"/>
                            <!-- Virtualizing Table -->
                            <RowDefinition Height="*"/>
                            <!-- Mini Sidechain Info -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Action Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ExtractViralShortsCommand}"
                                        Background="#EC4899" Foreground="#FFFFFF" BorderThickness="0"
                                        Padding="10,4" CornerRadius="5" FontSize="10" FontWeight="Bold" Cursor="Hand" Margin="0,0,6,0"
                                        ToolTip="Trích xuất 1 đoạn cao trào nhất &lt; 60s từ Whisper transcript + Tạo Hook 3s + Render 9:16">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ Trích Xuất Bản Shorts 60s (Viral Hook)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding BatchTranslateWithGlossaryCommand}"
                                        Background="#7C3AED" Foreground="#FFFFFF" BorderThickness="0"
                                        Padding="8,4" CornerRadius="5" FontSize="10" FontWeight="Bold" Cursor="Hand" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌐 Dịch Kịch Bản Với Glossary" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding RunAutoDiarizationCommand}"
                                    Background="#06B6D4" Foreground="#0B0D13" BorderThickness="0"
                                    Padding="8,4" CornerRadius="5" FontSize="10" FontWeight="Bold" Cursor="Hand">
                                <TextBlock Text="🤖 Phân Đoạn Diarization"/>
                            </Button>
                        </Grid>

                        <!-- 150 Script Lines Virtualizing Table -->
                        <Border Grid.Row="1" Background="#0B0D13" BorderBrush="#282F44" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ScriptLines}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#1E2332" BorderThickness="0,0,0,1" Padding="8,6">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftDoubleClick" 
                                                                  Command="{Binding DataContext.JumpToScriptLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#1E293B"/>
                                                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <!-- Header: Line ID + Speaker Badge + Time + Re-Fit -->
                                                        <RowDefinition Height="Auto"/>
                                                        <!-- Original Text -->
                                                        <RowDefinition Height="Auto"/>
                                                        <!-- Editable Dubbed Text -->
                                                        <RowDefinition Height="Auto"/>
                                                        <!-- Syllable Meter Badge -->
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Row 0: Metadata Bar -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="#282F44" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding Id, StringFormat='{}#{0}'}" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                                                            </Border>

                                                            <!-- Speaker Tag Badge -->
                                                            <Border Background="{Binding SpeakerBgColor, FallbackValue='#1E3A8A'}" CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding SpeakerDisplayName, FallbackValue='Speaker 1'}" 
                                                                           FontSize="9" FontWeight="Bold" Foreground="{Binding SpeakerColor, FallbackValue='#60A5FA'}"/>
                                                            </Border>

                                                            <TextBlock Text="{Binding TimeRangeFormatted}" FontSize="9" FontWeight="SemiBold" 
                                                                       Foreground="#06B6D4" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <!-- Gemini Re-Fit Button (<350ms SLA) -->
                                                        <Button Grid.Column="1" 
                                                                Command="{Binding DataContext.GeminiReFitLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Background="#7C3AED" Foreground="#FFFFFF" BorderThickness="0"
                                                                Padding="5,2" CornerRadius="4" Cursor="Hand" ToolTip="Tối ưu vừa vặn số từ trong < 350ms">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="M 7 2 L 17 2 L 10 11 L 15 11 L 5 22 L 8 13 L 3 13 Z" Fill="#FDE047" Width="8" Height="8" Stretch="Uniform" Margin="0,0,3,0"/>
                                                                <TextBlock Text="Re-Fit" FontSize="9" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Row 1: Original text (Read-Only) -->
                                                    <Border Grid.Row="1" Background="#06080D" BorderBrush="#1E2332" BorderThickness="1" CornerRadius="4" Padding="5,3" Margin="0,0,0,3">
                                                        <TextBlock Text="{Binding OriginalText}" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                                    </Border>

                                                    <!-- Row 2: Editable Dubbed Text -->
                                                    <TextBox Grid.Row="2" Text="{Binding DubbedText, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="#131722" Foreground="#F8FAFC" BorderBrush="#282F44" BorderThickness="1"
                                                             Padding="5,3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3"
                                                             CaretBrush="#38BDF8"/>

                                                    <!-- Row 3: Syllable Meter Badge -->
                                                    <Grid Grid.Row="3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="{Binding BadgeColor}" CornerRadius="8" Padding="6,1" Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding BadgeText}" FontSize="9" FontWeight="Bold" Foreground="#0B0D13"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding BadgeStatusDescription}" FontSize="9" Foreground="#64748B" VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1" Text="Đang Re-Fit..." FontSize="9" Foreground="#F59E0B" FontWeight="Bold"
                                                                   Visibility="{Binding IsReFitting, Converter={x:Static BooleanToVisibilityConverter.Instance}, FallbackValue=Collapsed}"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Bottom Notice -->
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <TextBlock Text="💡 Nhấp đúp vào 1 câu thoại để tua và phát lặp lại phân đoạn." FontSize="9" Foreground="#64748B"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 2: PHÂN VAI NHÂN VẬT (SPEAKER CASTING & DIARIZATION) -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥 Phân Vai Nhân Vật" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <Border Background="#10B981" CornerRadius="8" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SpeakerProfiles.Count, FallbackValue='3'}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Diarization Trigger Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="DANH SÁCH NHÂN VẬT &amp; GIỌNG ĐỌC" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="Gán mô hình giọng AI cho từng nhân vật trong video" FontSize="11" Foreground="#CBD5E1"/>
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding RunAutoDiarizationCommand}"
                                    Background="#06B6D4" Foreground="#0B0D13" BorderThickness="0"
                                    Padding="8,4" CornerRadius="5" FontSize="10" FontWeight="Bold" Cursor="Hand">
                                <TextBlock Text="⚡ Phân Vai Tự Động"/>
                            </Button>
                        </Grid>

                        <!-- Speaker Profiles List -->
                        <Border Grid.Row="1" Background="#0B0D13" BorderBrush="#282F44" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SpeakerProfiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#1E2332" BorderThickness="0,0,0,1" Padding="10,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Speaker Badge & Line stats -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="{Binding HexBgColor}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding SpeakerId}" FontSize="10" FontWeight="Bold" Foreground="{Binding HexColor}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Border Background="#1E2332" CornerRadius="4" Padding="4,1" Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding LineCount, StringFormat='{}{0} câu'}" FontSize="9" Foreground="#38BDF8"/>
                                                            </Border>
                                                            <Border Background="#1E2332" CornerRadius="4" Padding="4,1">
                                                                <TextBlock Text="{Binding TotalSpokenSec, StringFormat='{}{0:F1}s'}" FontSize="9" Foreground="#94A3B8"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Voice Assignment Info -->
                                                    <Grid Grid.Row="1" Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Giọng Gán:" FontSize="10" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="#131722" BorderBrush="#282F44" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{Binding AssignedVoiceModel}" FontSize="10" FontWeight="SemiBold" Foreground="#A78BFA" FontFamily="Consolas"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Pitch & Speed Sliders -->
                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Pitch Shift Slider -->
                                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                            <TextBlock Text="{Binding PitchShift, StringFormat='{}Cao độ (Pitch): {0:+0.0;-0.0;0.0}st'}" FontSize="9" Foreground="#94A3B8"/>
                                                            <Slider Minimum="-12" Maximum="12" Value="{Binding PitchShift, Mode=TwoWay}" SmallChange="0.5"/>
                                                        </StackPanel>

                                                        <!-- Speed Rate Slider -->
                                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                            <TextBlock Text="{Binding SpeechSpeedRate, StringFormat='{}Tốc độ: {0:F2}x'}" FontSize="9" Foreground="#94A3B8"/>
                                                            <Slider Minimum="0.5" Maximum="2.0" Value="{Binding SpeechSpeedRate, Mode=TwoWay}" SmallChange="0.05"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Voice Library Selector & Assign Action -->
                        <Border Grid.Row="2" Background="#0B0D13" BorderBrush="#282F44" BorderThickness="1" CornerRadius="8" Padding="8">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="KHO THƯ VIỆN GIỌNG ĐỌC STUDIO" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableVoices}" 
                                              SelectedItem="{Binding SelectedVoiceModel, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              Background="#131722" Foreground="#F8FAFC" Margin="0,0,4,0" FontSize="10"/>

                                    <Button Grid.Column="1" Command="{Binding AssignVoiceToSpeakerCommand}"
                                            Background="#7C3AED" Foreground="#FFFFFF" BorderThickness="0"
                                            Padding="8,4" CornerRadius="4" FontSize="10" FontWeight="Bold" Cursor="Hand">
                                        <TextBlock Text="Gán Giọng"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 3: TỪ ĐIỂN NGỮ CẢNH (CONTEXT GLOSSARY) -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖 Từ Điển Thuật Ngữ" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <Border Background="#A855F7" CornerRadius="8" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GlossaryItems.Count, FallbackValue='6'}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Batch Run -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="TỪ ĐIỂN QUY CHUẨN THUẬT NGỮ CHUYÊN NGÀNH" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="Đảm bảo Gemini không dịch sai tên riêng hoặc thuật ngữ kỹ thuật" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding BatchTranslateWithGlossaryCommand}"
                                    Background="#7C3AED" Foreground="#FFFFFF" BorderThickness="0"
                                    Padding="8,4" CornerRadius="5" FontSize="10" FontWeight="Bold" Cursor="Hand">
                                <TextBlock Text="⚡ Áp Dụng Dịch Toàn Bộ"/>
                            </Button>
                        </Grid>

                        <!-- Glossary List Table -->
                        <Border Grid.Row="1" Background="#0B0D13" BorderBrush="#282F44" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding GlossaryItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#1E2332" BorderThickness="0,0,0,1" Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsActive, Mode=TwoWay}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding SourceTerm}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                                            <TextBlock Text=" → " FontSize="11" Foreground="#64748B"/>
                                                            <TextBlock Text="{Binding TargetTranslation}" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Background="#1E2332" CornerRadius="3" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#94A3B8"/>
                                                    </Border>

                                                    <Button Grid.Column="3" Command="{Binding DataContext.RemoveGlossaryItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#EF4444" Foreground="#FFFFFF" BorderThickness="0"
                                                            Padding="4,2" CornerRadius="3" FontSize="9" FontWeight="Bold" Cursor="Hand">
                                                        <TextBlock Text="Xóa"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Add New Term Quick Form -->
                        <Border Grid.Row="2" Background="#0B0D13" BorderBrush="#282F44" BorderThickness="1" CornerRadius="8" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="THÊM THUẬT NGỮ MỚI" FontSize="10" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Text="{Binding NewGlossarySourceTerm, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#131722" Foreground="#F8FAFC" BorderBrush="#282F44" Padding="4,3" Margin="0,0,4,0" FontSize="10"/>

                                    <TextBox Grid.Column="1" Text="{Binding NewGlossaryTargetTranslation, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#131722" Foreground="#F8FAFC" BorderBrush="#282F44" Padding="4,3" Margin="0,0,4,0" FontSize="10"/>

                                    <ComboBox Grid.Column="2" SelectedValue="{Binding NewGlossaryCategory, Mode=TwoWay}"
                                              SelectedValuePath="Content"
                                              Background="#131722" Foreground="#F8FAFC" Margin="0,0,4,0" FontSize="10">
                                        <ComboBoxItem Content="Kỹ thuật" IsSelected="True"/>
                                        <ComboBoxItem Content="Ngôn ngữ"/>
                                        <ComboBoxItem Content="Thiết bị"/>
                                        <ComboBoxItem Content="Thương hiệu"/>
                                    </ComboBox>

                                    <Button Grid.Column="3" Command="{Binding AddGlossaryItemCommand}"
                                            Background="#10B981" Foreground="#0B0D13" BorderThickness="0"
                                            Padding="8,3" CornerRadius="4" FontSize="10" FontWeight="Bold" Cursor="Hand">
                                        <TextBlock Text="Thêm"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 4: BÀN TRỘN ÂM THANH & DSP SIDECHAIN -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎛️ Bàn Trộn Âm DSP" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="MULTI-TRACK HARDWARE AUDIO MIXER &amp; DSP" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock Text="Điều khiển âm lượng độc lập các track và độ nhạy Sidechain Ducking" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </Grid>

                        <!-- 4 Multi-Track Faders -->
                        <Border Grid.Row="1" Background="#0B0D13" BorderBrush="#282F44" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Track 1: Voice Track -->
                                <Border Grid.Column="0" Background="#131722" BorderBrush="#282F44" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,3,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Track Giọng Đọc" FontSize="9" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Center"/>
                                        <Slider Orientation="Vertical" Minimum="0" Maximum="1.5" Value="{Binding VoiceTrackVolume, Mode=TwoWay}" Height="120" Margin="0,8"/>
                                        <TextBlock Text="{Binding VoiceTrackVolume, StringFormat='{}{0:P0}'}" FontSize="9" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                        <Button Command="{Binding ToggleVoiceMuteCommand}"
                                                Background="{Binding IsVoiceMuted, Converter={x:Null}, FallbackValue='#EF4444'}" 
                                                Foreground="#FFFFFF" BorderThickness="0" Padding="6,2" CornerRadius="3" Margin="0,4,0,0" FontSize="9" Cursor="Hand">
                                            <TextBlock Text="MUTE"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Track 2: BGM Track -->
                                <Border Grid.Column="1" Background="#131722" BorderBrush="#282F44" BorderThickness="1" CornerRadius="6" Padding="6" Margin="3,0,3,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Track Nhạc BGM" FontSize="9" FontWeight="Bold" Foreground="#06B6D4" HorizontalAlignment="Center"/>
                                        <Slider Orientation="Vertical" Minimum="0" Maximum="1.5" Value="{Binding BgmTrackVolume, Mode=TwoWay}" Height="120" Margin="0,8"/>
                                        <TextBlock Text="{Binding BgmTrackVolume, StringFormat='{}{0:P0}'}" FontSize="9" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                        <Button Command="{Binding ToggleBgmMuteCommand}"
                                                Background="#EF4444" Foreground="#FFFFFF" BorderThickness="0" Padding="6,2" CornerRadius="3" Margin="0,4,0,0" FontSize="9" Cursor="Hand">
                                            <TextBlock Text="MUTE"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Track 3: SFX Track -->
                                <Border Grid.Column="2" Background="#131722" BorderBrush="#282F44" BorderThickness="1" CornerRadius="6" Padding="6" Margin="3,0,3,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Track Hiệu Ứng" FontSize="9" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                                        <Slider Orientation="Vertical" Minimum="0" Maximum="1.5" Value="{Binding SfxTrackVolume, Mode=TwoWay}" Height="120" Margin="0,8"/>
                                        <TextBlock Text="{Binding SfxTrackVolume, StringFormat='{}{0:P0}'}" FontSize="9" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                        <Button Background="#282F44" Foreground="#CBD5E1" BorderThickness="0" Padding="6,2" CornerRadius="3" Margin="0,4,0,0" FontSize="9">
                                            <TextBlock Text="MUTE"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Track 4: Master Output -->
                                <Border Grid.Column="3" Background="#131722" BorderBrush="#282F44" BorderThickness="1" CornerRadius="6" Padding="6" Margin="3,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Master Output" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                        <Slider Orientation="Vertical" Minimum="0" Maximum="1.5" Value="{Binding MasterVolume, Mode=TwoWay}" Height="120" Margin="0,8"/>
                                        <TextBlock Text="{Binding MasterVolume, StringFormat='{}{0:P0}'}" FontSize="9" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                        <Border Background="#10B981" CornerRadius="3" Padding="4,1" Margin="0,4,0,0">
                                            <TextBlock Text="0 dB" FontSize="9" FontWeight="Bold" Foreground="#0B0D13" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Hardware Sidechain Knobs -->
                        <Border Grid.Row="2" Background="#0B0D13" BorderBrush="#282F44" BorderThickness="1" CornerRadius="8" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="DSP SIDECHAIN DUCKING (HẠ ÂM NHẠC NỀN TỰ ĐỘNG)" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Knob 1 -->
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding DuckingThresholdDb, StringFormat='{}Threshold: {0:F0}dB'}" FontSize="9" Foreground="#CBD5E1"/>
                                        <Slider Minimum="-36" Maximum="0" Value="{Binding DuckingThresholdDb, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <!-- Knob 2 -->
                                    <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                        <TextBlock Text="Attack: 20ms / Release: 280ms" FontSize="9" Foreground="#CBD5E1"/>
                                        <ProgressBar Value="75" Height="6" Margin="0,6"/>
                                    </StackPanel>

                                    <!-- Knob 3 -->
                                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding MusicVoiceBalance, StringFormat='{}Balance: {0:P0}'}" FontSize="9" Foreground="#CBD5E1"/>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding MusicVoiceBalance, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
