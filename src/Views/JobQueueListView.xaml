<UserControl x:Class="CreatorOS.Desktop.Wpf.Views.JobQueueListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CreatorOS.Desktop.Wpf.ViewModels"
             xmlns:contracts="clr-namespace:CreatorOS.Core.Contracts"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#121214"
             Foreground="#ECECED"
             FontFamily="Segoe UI, Inter, Arial"
             FontSize="13">

    <!-- ============================================================================== -->
    <!-- CreatorOS Desktop - Principal Systems Engineer Guidelines (Karpathy Pattern)  -->
    <!-- File: JobQueueListView.xaml                                                   -->
    <!-- UI Virtualization, Low VRAM Footprint, 60 FPS Native Dark Theme Styles         -->
    <!-- ============================================================================== -->

    <UserControl.Resources>
        <!-- Solid Brushes -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#121214" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1A1E" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#24242A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2E2E36" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="#10B981" />
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="DangerRedBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9CA3AF" />

        <!-- Status Badge Style -->
        <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="{x:Static contracts:JobStatus.Queued}">
                    <Setter Property="Background" Value="#26374A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="{x:Static contracts:JobStatus.Processing}">
                    <Setter Property="Background" Value="#1E3A8A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="{x:Static contracts:JobStatus.Completed}">
                    <Setter Property="Background" Value="#064E3B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="{x:Static contracts:JobStatus.Failed}">
                    <Setter Property="Background" Value="#7F1D1D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="{x:Static contracts:JobStatus.Cancelled}">
                    <Setter Property="Background" Value="#374151" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="{x:Static contracts:JobStatus.Queued}">
                    <Setter Property="Foreground" Value="#93C5FD" />
                    <Setter Property="Text" Value="ĐANG CHỜ" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="{x:Static contracts:JobStatus.Processing}">
                    <Setter Property="Foreground" Value="#60A5FA" />
                    <Setter Property="Text" Value="ĐANG XỬ LÝ" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="{x:Static contracts:JobStatus.Completed}">
                    <Setter Property="Foreground" Value="#6EE7B7" />
                    <Setter Property="Text" Value="HOÀN THÀNH" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="{x:Static contracts:JobStatus.Failed}">
                    <Setter Property="Foreground" Value="#FCA5A5" />
                    <Setter Property="Text" Value="THẤT BÀI" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="{x:Static contracts:JobStatus.Cancelled}">
                    <Setter Property="Foreground" Value="#D1D5DB" />
                    <Setter Property="Text" Value="ĐÃ HỦY" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Compact Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#26262E" />
            <Setter Property="Foreground" Value="#ECECED" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#353540" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4B5563" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E1E24" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Smooth Flat Progress Bar -->
        <Style x:Key="FlatProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="#26262C" />
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" 
                                    Background="{TemplateBinding Foreground}" 
                                    CornerRadius="3" 
                                    HorizontalAlignment="Left" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Value" Value="100">
                                <Setter TargetName="PART_Indicator" Property="Background" Value="{StaticResource SuccessGreenBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Container -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Panel with Batch Actions & Metrics -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="HÀNG ĐỢI TÁC VỤ IN-PROCESS" FontWeight="Bold" FontSize="14" Foreground="#F3F4F6" VerticalAlignment="Center" Margin="0,0,16,0" />
                    
                    <Border Background="#26262E" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="{Binding QueuedCount, StringFormat='Chờ: {0}', Mode=OneWay}" Foreground="#93C5FD" FontSize="12" />
                    </Border>
                    <Border Background="#26262E" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="{Binding ProcessingCount, StringFormat='Đang chạy: {0}', Mode=OneWay}" Foreground="#60A5FA" FontSize="12" />
                    </Border>
                    <Border Background="#26262E" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="{Binding CompletedCount, StringFormat='Hoàn thành: {0}', Mode=OneWay}" Foreground="#6EE7B7" FontSize="12" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Hủy tất cả" 
                            Command="{Binding CancelAllJobsCommand}" 
                            Style="{StaticResource ActionButtonStyle}" 
                            Foreground="{StaticResource DangerRedBrush}" />
                    <Button Content="Mở thư mục xuất" 
                            Command="{Binding OpenExportFolderCommand}" 
                            CommandParameter="{x:Null}"
                            Style="{StaticResource ActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 
            Virtualizing ListView:
            - VirtualizingStackPanel.IsVirtualizing="True"
            - VirtualizingStackPanel.VirtualizationMode="Recycling" (Tái sử dụng visual container, không cấp phát thừa)
            - ScrollViewer.IsDeferredScrollingEnabled="False" (Cuộn mượt mà tức thời)
        -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Jobs, Mode=OneWay}"
                  SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                  Background="Transparent"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.IsDeferredScrollingEnabled="False"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  VirtualizingStackPanel.ScrollUnit="Pixel">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Padding" Value="12,10" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#22283A" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:JobItemViewModel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Thumbnail with LowQuality BitmapScaling (Low VRAM Footprint) -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Main Info & Progress -->
                            <ColumnDefinition Width="*" />
                            <!-- Status Badge -->
                            <ColumnDefinition Width="110" />
                            <!-- Action Buttons -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail Container -->
                        <Border Grid.Column="0" 
                                Width="54" Height="40" 
                                CornerRadius="4" 
                                Background="#26262E" 
                                Margin="0,0,12,0"
                                RenderOptions.BitmapScalingMode="LowQuality">
                            <TextBlock Text="🎬" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Details & Progress Section -->
                        <Grid Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Title & Metric Meta -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="{Binding Title, Mode=OneWay}" 
                                           FontWeight="SemiBold" 
                                           FontSize="13" 
                                           Foreground="#F9FAFB"
                                           TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Fps, StringFormat='{}{0:F0} FPS', Mode=OneWay}" 
                                               Foreground="{StaticResource TextMutedBrush}" 
                                               FontSize="11" 
                                               Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding EtaString, StringFormat='ETA: {0}', Mode=OneWay}" 
                                               Foreground="{StaticResource TextMutedBrush}" 
                                               FontSize="11" 
                                               Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Progress, StringFormat='{}{0:F1}%', Mode=OneWay}" 
                                               FontWeight="Bold" 
                                               Foreground="{StaticResource AccentBlueBrush}" 
                                               FontSize="11" />
                                </StackPanel>
                            </Grid>

                            <!-- Progress Bar (OneWay binding) -->
                            <ProgressBar Grid.Row="1" 
                                         Value="{Binding Progress, Mode=OneWay}" 
                                         Minimum="0" Maximum="100" 
                                         Style="{StaticResource FlatProgressBarStyle}" 
                                         Margin="0,0,0,5" />

                            <!-- Status Log with Ellipsis -->
                            <TextBlock Grid.Row="2" 
                                       Text="{Binding StatusText, Mode=OneWay}" 
                                       Foreground="{StaticResource TextMutedBrush}" 
                                       FontSize="11" 
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <!-- Status Badge -->
                        <Border Grid.Column="2" Style="{StaticResource StatusBadgeBorderStyle}">
                            <TextBlock Style="{StaticResource StatusBadgeTextStyle}" />
                        </Border>

                        <!-- Actions Column (Fixed Width & Right Aligned) -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button Content="Chạy lại"
                                    Command="{Binding DataContext.StartJobCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource ActionButtonStyle}" />
                            
                            <Button Content="Hủy"
                                    Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Foreground="{StaticResource DangerRedBrush}" />

                            <Button Content="Mở thư mục"
                                    Command="{Binding OpenExportFolderCommand}"
                                    Style="{StaticResource ActionButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Footer System Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding SystemStatusText, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding OverallProgress, StringFormat='Tổng tiến độ: {0:F1}%', Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" FontSize="12" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
