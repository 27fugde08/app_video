<Window x:Class="CreatorOS.Desktop.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:CreatorOS.Desktop.Wpf.ViewModels"
        xmlns:views="clr-namespace:CreatorOS.Desktop.Wpf.Views"
        mc:Ignorable="d"
        x:Name="MainWindowRoot"
        Title="{Binding WindowTitle, FallbackValue='CreatorOS Studio Native — Dark Slate Pro Workstation'}" 
        Height="900" Width="1440"
        MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource ObsidianBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFontFamily}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Global Key Bindings (Ctrl + K for Spotlight) -->
    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding OpenSpotlightCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseSpotlightCommand}" />
    </Window.InputBindings>

    <Grid Background="{StaticResource ObsidianBaseBrush}">
        <Grid.RowDefinitions>
            <!-- 1. Global Hardware Diagnostics Header (44px) -->
            <RowDefinition Height="44"/>
            <!-- 2. Main Workspace: Collapsible Sidebar + Content Presenter -->
            <RowDefinition Height="*"/>
            <!-- 3. Micro Status Footer (26px) -->
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- 1. GLOBAL HARDWARE DIAGNOSTICS HEADER (44PX)                             -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" 
                Background="{StaticResource CardSurfaceBrush}" 
                BorderBrush="{StaticResource BorderSubtleBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Brand Identity & Version Badge -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Central Spotlight Search Trigger (Ctrl + K) -->
                    <ColumnDefinition Width="340"/>
                    <!-- Real-Time Hardware Diagnostics Cluster -->
                    <ColumnDefinition Width="*"/>
                    <!-- Purge RAM & Window Control Buttons -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Width="26" Height="26" CornerRadius="{StaticResource ButtonCornerRadius}" Margin="0,0,8,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource ColorActiveCyan}" Offset="0"/>
                                <GradientStop Color="{StaticResource ColorNeonPurple}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⚡" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CREATOR" FontWeight="ExtraBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="OS" FontWeight="ExtraBold" FontSize="14" Foreground="{StaticResource ActiveCyanBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Central Spotlight Search Trigger (Ctrl + K) -->
                <Border Grid.Column="1" 
                        Background="{StaticResource ElevatedPanelBrush}" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" 
                        BorderThickness="1" 
                        CornerRadius="{StaticResource ButtonCornerRadius}" 
                        Height="28" 
                        Padding="8,0" 
                        Cursor="Hand"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding OpenSpotlightCommand}" />
                    </Border.InputBindings>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="Tìm tính năng, kịch bản, module..." 
                                   FontSize="{StaticResource FontSizeSmall}" 
                                   Foreground="{StaticResource TextMutedBrush}" 
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="2" 
                                Background="{StaticResource CardSurfaceBrush}" 
                                BorderBrush="{StaticResource BorderSubtleBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="4,1" 
                                VerticalAlignment="Center">
                            <TextBlock Text="Ctrl + K" 
                                       FontSize="9" 
                                       FontFamily="{StaticResource MonoFontFamily}" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Real-Time Hardware Telemetry Cluster -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- CPU % -->
                    <Border Background="{StaticResource ElevatedPanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource ButtonCornerRadius}" Padding="7,3" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💻 CPU: " FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding CpuUsageText, FallbackValue='8.4% (16-Core)'}" 
                                       Style="{StaticResource TelemetryValueStyle}" 
                                       Foreground="{StaticResource ActiveCyanBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- RAM Used (MB) -->
                    <Border Background="{StaticResource ElevatedPanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource ButtonCornerRadius}" Padding="7,3" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🧠 RAM: " FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding RamUsageText, FallbackValue='312 MB'}" 
                                       Style="{StaticResource TelemetryValueStyle}" 
                                       Foreground="{StaticResource NeonPurpleBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- VRAM GPU % (With Dynamic Spectrum Indicator) -->
                    <Border Background="{StaticResource ElevatedPanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource ButtonCornerRadius}" Padding="7,3" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎮 VRAM: " FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding GpuVramText, FallbackValue='3.1 / 8.0 GB (38%)'}" 
                                       Style="{StaticResource TelemetryValueStyle}" 
                                       Foreground="{StaticResource EmeraldGreenBrush}" 
                                       Margin="0,0,6,0"/>
                            <!-- Mini VRAM Progress Bar -->
                            <Border Width="36" Height="4" Background="{StaticResource ObsidianBaseBrush}" CornerRadius="2" VerticalAlignment="Center">
                                <Border Width="14" HorizontalAlignment="Left" Background="{StaticResource EmeraldGreenBrush}" CornerRadius="2"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Active NVENC Workers -->
                    <Border Background="{StaticResource ElevatedPanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource ButtonCornerRadius}" Padding="7,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ NVENC: " FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding NvencWorkersText, FallbackValue='2 / 3 Active (p6)'}" 
                                       Style="{StaticResource TelemetryValueStyle}" 
                                       Foreground="{StaticResource WarningAmberBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Action Controls: Native Window Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Native Window Chrome Buttons (Minimize, Maximize, Close) -->
                    <Button Style="{StaticResource WorkstationButtonStyle}"
                            Command="{Binding MinimizeWindowCommand}"
                            CommandParameter="{Binding ElementName=MainWindowRoot}"
                            Width="28" Height="26" Padding="0" Margin="0,0,2,0"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="Thu nhỏ cửa sổ">
                        <TextBlock Text="—" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </Button>

                    <Button Style="{StaticResource WorkstationButtonStyle}"
                            Command="{Binding MaximizeWindowCommand}"
                            CommandParameter="{Binding ElementName=MainWindowRoot}"
                            Width="28" Height="26" Padding="0" Margin="0,0,2,0"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="Phóng to / Khôi phục">
                        <TextBlock Text="🗖" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </Button>

                    <Button Style="{StaticResource WorkstationButtonStyle}"
                            Command="{Binding CloseWindowCommand}"
                            CommandParameter="{Binding ElementName=MainWindowRoot}"
                            Width="28" Height="26" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="Đóng ứng dụng">
                        <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource ErrorCrimsonBrush}" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 2. MAIN WORKSPACE: COLLAPSIBLE SIDEBAR + CENTER CONTENT PRESENTER         -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Collapsible Sidebar (240px <-> 60px) -->
                <ColumnDefinition Width="{Binding SidebarWidth, FallbackValue=240, Mode=OneWay}"/>
                <!-- Right: Dynamic Central Workspace -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR: DARK SLATE PRO WORKSTATION -->
            <Border Grid.Column="0" 
                    Background="{StaticResource CardSurfaceBrush}" 
                    BorderBrush="{StaticResource BorderSubtleBrush}" 
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Sidebar Collapse/Expand Header -->
                        <RowDefinition Height="36"/>
                        <!-- Nav Groups Scroll Area -->
                        <RowDefinition Height="*"/>
                        <!-- License Tier & Settings Footer -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Toggle Bar -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                        <Grid>
                            <TextBlock Text="WORKSPACE MODULES" 
                                       FontSize="9" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextMutedBrush}" 
                                       VerticalAlignment="Center" 
                                       Margin="6,0,0,0"
                                       Visibility="{Binding IsSidebarCollapsed, Converter={x:Static ObjectConverters.Null}}"/>
                            
                            <Button HorizontalAlignment="Right" 
                                    Command="{Binding ToggleSidebarCommand}"
                                    Style="{StaticResource WorkstationButtonStyle}"
                                    Width="24" Height="24" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTip="Thu gọn / Mở rộng sidebar">
                                <TextBlock Text="⇋" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Navigation Groups -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="6,8">
                            <!-- NHÓM 1: SẢN XUẤT NỘI DUNG -->
                            <TextBlock Text="SẢN XUẤT NỘI DUNG" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="8,4,0,4"/>

                            <!-- 1. Batch Downloader Pro -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="downloader">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📥" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Batch Downloader Pro" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. Dịch & Lồng Tiếng AI (Đã tích hợp Tóm Tắt, Truyện Tranh & Cắt Viral Hook Shorts) -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="dubbing">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Dịch &amp; Lồng Tiếng AI" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. Studio Edit Timeline (D3D11) -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="timeline">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎞️" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Timeline Studio (D3D11)" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- NHÓM 2: XỬ LÝ CHUYÊN SÂU -->
                            <TextBlock Text="XỬ LÝ CHUYÊN SÂU" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="8,12,0,4"/>

                            <!-- 5. Voice Studio & Clone -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="voice">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎙️" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Voice Studio &amp; Clone" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- 6. Lip-Sync Wav2Lip -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="lipsync">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👄" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Lip-Sync Wav2Lip Studio" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- 7. Auto 3D Thumbnail & SEO -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="thumbnail">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖼️" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Auto 3D Thumbnail &amp; SEO" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- 8. Content ID Shield -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="shield">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡️" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Content ID Shield" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- NHÓM 3: HỆ THỐNG & XUẤT BẢN -->
                            <TextBlock Text="HỆ THỐNG &amp; XUẤT BẢN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="8,12,0,4"/>

                            <!-- 9. Đăng Tải Đa Kênh -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="publisher">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Đăng Tải Đa Kênh" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>

                            <!-- 10. Master Job Queue / Settings -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="queue">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Cài Đặt &amp; Quản Lý Luồng" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Footer: License Tier & Settings -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="10,8" Background="{StaticResource ObsidianBaseBrush}">
                        <StackPanel>
                            <!-- License Tier Badge Card -->
                            <Border Background="{StaticResource ElevatedPanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource ButtonCornerRadius}" Padding="8,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🛡️" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="CreatorOS Pro" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding LicenseTier, FallbackValue='PRO_V48 Lifetime'}" FontSize="9" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource NeonPurpleBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#1B3A2C" BorderBrush="{StaticResource EmeraldGreenBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                        <TextBlock Text="ACTIVE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource EmeraldGreenBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Settings Button -->
                            <Button Style="{StaticResource WorkstationButtonStyle}" 
                                    Command="{Binding NavigateCommand}" 
                                    CommandParameter="queue"
                                    HorizontalContentAlignment="Left"
                                    Padding="8,5"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="Cài Đặt Hệ Thống (Settings)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- CENTER WORKSPACE: LAZY LOADING USERCONTROL HOST WITH 120MS FADE -->
            <Border Grid.Column="1" Background="{StaticResource ObsidianBaseBrush}">
                <ContentControl Content="{Binding CurrentView}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <!-- Storyboard Fade Transition (120ms) on ViewModel Change -->
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.0" To="1.0"
                                                             Duration="0:0:0.120"
                                                             DecelerationRatio="0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 3. MICRO STATUS FOOTER (26PX)                                             -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2" 
                Background="{StaticResource CardSurfaceBrush}" 
                BorderBrush="{StaticResource BorderSubtleBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="{Binding StatusFooterText, FallbackValue='🟢 Dark Slate Pro Workstation • 100% In-Process CLR • Direct3D 11 Surface'}" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           FontSize="10" 
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="60 FPS NATIVE DISPATCHER" 
                               FontFamily="{StaticResource MonoFontFamily}" 
                               FontSize="9" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource EmeraldGreenBrush}" 
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="DIRECT3D 11 NVENC ENGINE" 
                               FontFamily="{StaticResource MonoFontFamily}" 
                               FontSize="9" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource ActiveCyanBrush}"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>
                    <Border Background="#1A1828" 
                            BorderBrush="{StaticResource NeonPurpleBrush}" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="6,1" 
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionBadge, FallbackValue='#PRO_V48'}" 
                                   FontSize="9" 
                                   FontFamily="{StaticResource MonoFontFamily}" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource NeonPurpleBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- SPOTLIGHT QUICK LAUNCHER MODAL OVERLAY (CTRL + K)                         -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" 
              Background="{StaticResource BackdropOverlayBrush}" 
              Visibility="{Binding IsSpotlightOpen, Converter={x:Static ObjectConverters.Null}}"
              Panel.ZIndex="1000">
            <Grid.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseSpotlightCommand}"/>
            </Grid.InputBindings>

            <!-- Centered Spotlight Box -->
            <Border Width="620" 
                    MaxHeight="480" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Top" 
                    Margin="0,90,0,0"
                    Style="{StaticResource WorkstationCardStyle}"
                    Background="{StaticResource CardSurfaceBrush}"
                    BorderBrush="{StaticResource BorderHighlightBrush}"
                    BorderThickness="1"
                    Padding="0">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseSpotlightCommand}" />
                </Border.InputBindings>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Search Input Row -->
                        <RowDefinition Height="50"/>
                        <!-- Results List -->
                        <RowDefinition Height="*"/>
                        <!-- Shortcut Hints Footer -->
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>

                    <!-- Search Input Box -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource ActiveCyanBrush}"/>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding SpotlightQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" 
                                     Foreground="{StaticResource TextPrimaryBrush}" 
                                     BorderThickness="0" 
                                     FontSize="14" 
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center"/>
                            <Button Grid.Column="2" 
                                    Command="{Binding CloseSpotlightCommand}"
                                    Content="Esc" 
                                    FontSize="10" 
                                    FontFamily="{StaticResource MonoFontFamily}"
                                    Style="{StaticResource WorkstationButtonStyle}" 
                                    Padding="6,2" 
                                    Height="22"/>
                        </Grid>
                    </Border>

                    <!-- Filtered Spotlight Items List -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding FilteredSpotlightItems}"
                             Background="Transparent" 
                             BorderThickness="0" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MaxHeight="360"
                             Padding="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:SpotlightItem}">
                                <Border Style="{StaticResource WorkstationCardStyle}" 
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        Padding="10,8" 
                                        Margin="0,0,0,2"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" 
                                                      Command="{Binding DataContext.SelectSpotlightItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="26" Height="26" Background="{StaticResource ElevatedPanelBrush}" CornerRadius="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IconChar}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{StaticResource ElevatedPanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="9" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" Foreground="{StaticResource NeonPurpleBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Shortcut Hints Footer -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Background="{StaticResource ObsidianBaseBrush}" Padding="14,0">
                        <Grid VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="[↑↓] Điều hướng" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0"/>
