<UserControl x:Class="CreatorOS.Desktop.Wpf.Views.PublisherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:CreatorOS.Desktop.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1180"
             Background="#0F172A">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Top Connected Channels Grid -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content: Left Visual Schedule Calendar / Right Post Details -->
            <RowDefinition Height="*"/>
            <!-- Bottom Upload Progress Bar & Action -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Connected Channels -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🌐 Danh Sách Kênh Liên Kết (Windows DPAPI Encrypted Vault)" Foreground="#38BDF8" FontWeight="Bold" FontSize="13"/>
                    <Button Grid.Column="1" Content="➕ Thêm Kênh Mới" Background="#334155" Foreground="#34D399" FontWeight="SemiBold" FontSize="11" Padding="10,4" BorderThickness="0"/>
                </Grid>

                <!-- Channels List Horizontal -->
                <ListBox Grid.Row="1" ItemsSource="{Binding ConnectedChannels}" SelectedItem="{Binding SelectedChannel}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Padding="12,8" Margin="0,0,12,0" Width="220">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PlatformIcon}" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ChannelName}" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StatusBadge}" Foreground="#34D399" FontSize="10"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Visual Calendar & Queue -->
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="12"/>
                <!-- Right: Schedule & Publish Composer -->
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Visual Schedule Calendar -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📅 Lịch Biểu Xuất Bản Tương Tác (Visual Schedule)" Foreground="#FCD34D" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="Bộ định giờ ngầm: PeriodicTimer(30s)" Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ScheduledCalendarPosts}"
                              AutoGenerateColumns="False" 
                              Background="Transparent" 
                              RowBackground="#0F172A" 
                              AlternatingRowBackground="#1E293B"
                              BorderThickness="0" 
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#334155"
                              CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="THỜI GIAN ĐĂNG" Binding="{Binding ScheduledTimeString}" Width="130" Foreground="#38BDF8" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="TIÊU ĐỀ VIDEO" Binding="{Binding Title}" Width="*" Foreground="#F8FAFC"/>
                            <DataGridTextColumn Header="NỀN TẢNG" Binding="{Binding PlatformsString}" Width="160" Foreground="#FCD34D"/>
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="100" Foreground="#34D399"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right: Post Composer -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📝 Soạn Lịch Đăng Video" Foreground="#34D399" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                    <!-- Video File Path -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="File Video Xuất Bản:" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedVideoPath, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1"
                                 Padding="6,4" FontSize="11"/>
                    </StackPanel>

                    <!-- Title -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Text="Tiêu Đề Video:" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PostTitle, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1"
                                 Padding="6,4" FontSize="11"/>
                    </StackPanel>

                    <!-- Description -->
                    <Grid Grid.Row="3" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Mô Tả &amp; Hashtags:" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Grid.Row="1" Text="{Binding PostDescription, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1"
                                 Padding="8" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </Grid>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="⏰ Lên Lịch Đăng" Command="{Binding SchedulePostToCalendarCommand}"
                                Background="#8B5CF6" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,8" BorderThickness="0"/>
                        <Button Grid.Column="2" Content="🚀 Đăng Ngay (8MB Resumable)" Command="{Binding PublishImmediatelyCommand}"
                                Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,8" BorderThickness="0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Upload Progress Bar & Action -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,12,0,0" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ProgressBar Value="{Binding UploadProgress}" Maximum="100" Height="6" Width="380" HorizontalAlignment="Left"
                                 Background="#334155" Foreground="#10B981" BorderThickness="0"
                                 Visibility="{Binding IsUploading, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding TransferSpeed, StringFormat='{}Tốc độ: {0:F1} MB/s'}" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
