<UserControl x:Class="CreatorOS.Desktop.Wpf.Views.BatchDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:CreatorOS.Desktop.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="{StaticResource ObsidianBaseBrush}">

    <UserControl.Resources>
        <!-- Style cho các khối phân đoạn Chunk Map (HTTP/3 Segments) -->
        <Style x:Key="ChunkBlockStyle" TargetType="Border">
            <Setter Property="Height" Value="14"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 1. Thanh Điều Khiển Đầu Vào (Top Action Bar) -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Khu Vực Giám Sát Băng Thông (Live Metrics Card) -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Bảng Danh Sách Hàng Đợi Ảo Hóa (VirtualizingDataGrid) -->
            <RowDefinition Height="*"/>
            <!-- 4. Micro Status Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- 1. THANH ĐIỀU KHIỂN ĐẦU VÀO (TOP ACTION BAR)                              -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" 
                Style="{StaticResource WorkstationCardStyle}"
                Margin="0,0,0,12" 
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Multiline URL Input TextBox (Hỗ trợ dán 50+ links cùng lúc) -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="🔗" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="DANH SÁCH LIÊN KẾT TẢI HÀNG LOẠT (TIKTOK / DOUYIN / YOUTUBE)" 
                                       FontSize="{StaticResource FontSizeMicro}" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Hỗ trợ dán 50+ liên kết cùng lúc • HTTP/3 QUIC In-Process" 
                                   DockPanel.Dock="Right" 
                                   HorizontalAlignment="Right"
                                   FontSize="{StaticResource FontSizeMicro}" 
                                   Foreground="{StaticResource TextMutedBrush}" 
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBox Grid.Row="1"
                             Text="{Binding UrlBatchInput, UpdateSourceTrigger=PropertyChanged}"
                             Height="68"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource ElevatedPanelBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderSubtleBrush}"
                             BorderThickness="1"
                             Padding="10,8"
                             FontFamily="{StaticResource MonoFontFamily}"
                             FontSize="{StaticResource FontSizeSmall}"
                             TextWrapping="Wrap"/>
                </Grid>

                <!-- Row 1: Action Controls Toolbar -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- ComboBox Chọn Chất Lượng -->
                        <ColumnDefinition Width="220"/>
                        <!-- Checkbox Auto-Dubbing Toggle -->
                        <ColumnDefinition Width="*"/>
                        <!-- Primary Action & Batch Operations -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- ComboBox Chọn Chất Lượng -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Độ Phân Giải:" 
                                   FontSize="{StaticResource FontSizeSmall}" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding QualityOptions}"
                                  SelectedItem="{Binding SelectedQuality}"
                                  Width="135"
                                  Height="30"
                                  Background="{StaticResource ElevatedPanelBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderSubtleBrush}"
                                  FontSize="{StaticResource FontSizeSmall}"/>
                    </StackPanel>

                    <!-- Checkbox Toggle: Tự động gửi sang Lồng Tiếng sau khi tải xong -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <CheckBox IsChecked="{Binding AutoSendToDubbing}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                <TextBlock Text="🎙️" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="Tự động gửi sang Lồng Tiếng sau khi tải xong" 
                                           FontSize="{StaticResource FontSizeSmall}" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Border Background="#1E293B" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="PIPELINE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource ActiveCyanBrush}"/>
                                </Border>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>

                    <!-- Action Buttons Cluster -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Benchmark 100 Items Button (Kiểm chứng 60 FPS) -->
                        <Button Style="{StaticResource WorkstationButtonStyle}"
                                Content="+ 100 Link Demo"
                                ToolTip="Nạp 100 tác vụ kiểm chứng 60 FPS VirtualizingStackPanel"
                                Padding="10,5"
                                Margin="0,0,8,0"
                                Command="{Binding Add100BenchmarkItemsCommand}"/>

                        <!-- Thao tác hàng loạt: Tạm dừng / Tiếp tục -->
                        <Button Style="{StaticResource WorkstationButtonStyle}"
                                Content="Tạm Dừng Tất Cả"
                                Padding="10,5"
                                Margin="0,0,6,0"
                                Command="{Binding PauseAllCommand}"/>

                        <Button Style="{StaticResource WorkstationButtonStyle}"
                                Content="Tiếp Tục Tất Cả"
                                Padding="10,5"
                                Margin="0,0,6,0"
                                Command="{Binding ResumeAllCommand}"/>

                        <Button Style="{StaticResource WorkstationButtonStyle}"
                                Content="Dọn Đã Xong"
                                Padding="10,5"
                                Margin="0,0,10,0"
                                Command="{Binding ClearCompletedCommand}"/>

                        <!-- Nút Primary "Bắt Đầu Tải Hàng Loạt" (Màu tím neon #7C3AED) -->
                        <Button Style="{StaticResource WorkstationButtonStyle}"
                                Background="{StaticResource NeonPurpleBrush}"
                                BorderBrush="{StaticResource NeonPurpleBrush}"
                                Foreground="#FFFFFF"
                                FontWeight="Bold"
                                Padding="16,6"
                                Cursor="Hand"
                                Command="{Binding StartBatchDownloadCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Bắt Đầu Tải Hàng Loạt" FontSize="{StaticResource FontSizeRegular}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 2. KHU VỰC GIÁM SÁT BĂNG THÔNG (LIVE METRICS CARD)                         -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!-- Card 1: Tốc độ tổng (MB/s) -->
                <ColumnDefinition Width="200"/>
                <!-- Card 2: Dung lượng đã tải / Tổng dung lượng -->
                <ColumnDefinition Width="230"/>
                <!-- Card 3: Số luồng socket active -->
                <ColumnDefinition Width="190"/>
                <!-- Card 4: Sparkline Biểu đồ sóng Băng Thông 30 giây gần nhất (Direct2D/Vector) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Tổng Tốc Độ Mạng -->
            <Border Grid.Column="0" 
                    Style="{StaticResource WorkstationCardStyle}" 
                    Margin="0,0,8,0" 
                    Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="⚡" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock Text="TỔNG TỐC ĐỘ BĂNG THÔNG" 
                                   FontSize="{StaticResource FontSizeMicro}" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding TotalAggregateSpeedMb, StringFormat='{}{0:F1}'}" 
                                   FontSize="24" 
                                   FontWeight="ExtraBold" 
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{StaticResource ActiveCyanBrush}"/>
                        <TextBlock Text=" MB/s" 
                                   FontSize="13" 
                                   FontWeight="Bold" 
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   VerticalAlignment="Bottom" 
                                   Margin="2,0,0,3"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: Dung lượng đã tải / Tổng dung lượng -->
            <Border Grid.Column="1" 
                    Style="{StaticResource WorkstationCardStyle}" 
                    Margin="0,0,8,0" 
                    Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="💾" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock Text="DUNG LƯỢNG ĐÃ TẢI / TỔNG" 
                                   FontSize="{StaticResource FontSizeMicro}" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding DownloadedBytesFormatted}" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{StaticResource EmeraldGreenBrush}"/>
                        <TextBlock Text=" / " 
                                   FontSize="13" 
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{StaticResource TextMutedBrush}" 
                                   VerticalAlignment="Bottom" 
                                   Margin="2,0,2,2"/>
                        <TextBlock Text="{Binding TotalExpectedBytesFormatted}" 
                                   FontSize="13" 
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   VerticalAlignment="Bottom" 
                                   Margin="0,0,0,2"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 3: Số Luồng Socket Active -->
            <Border Grid.Column="2" 
                    Style="{StaticResource WorkstationCardStyle}" 
                    Margin="0,0,8,0" 
                    Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="🌐" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock Text="SOCKETS ACTIVE (HTTP/3)" 
                                   FontSize="{StaticResource FontSizeMicro}" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding ActiveSocketsCount}" 
                                   FontSize="22" 
                                   FontWeight="ExtraBold" 
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{StaticResource NeonPurpleBrush}"/>
                        <TextBlock Text=" luồng" 
                                   FontSize="12" 
                                   FontFamily="{StaticResource UiFontFamily}"
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   VerticalAlignment="Bottom" 
                                   Margin="4,0,8,3"/>

                        <!-- Active State Indicator Badge -->
                        <Border Background="#162925" BorderBrush="{StaticResource EmeraldGreenBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                            <TextBlock Text="QUIC READY" FontSize="8" FontWeight="Bold" Foreground="{StaticResource EmeraldGreenBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 4: Sparkline Biểu Đồ Sóng 30s Gần Nhất (Direct2D/Vector) -->
            <Border Grid.Column="3" 
                    Style="{StaticResource WorkstationCardStyle}" 
                    Padding="12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sparkline Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="📈" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock Text="DAO ĐỘNG BĂNG THÔNG 30 GIÂY GẦN NHẤT" 
                                       FontSize="{StaticResource FontSizeMicro}" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock Text="Peak: 100 MB/s" FontSize="9" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                            <Border Background="#1B263B" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="VECTOR D2D" FontSize="8" FontWeight="Bold" Foreground="{StaticResource ActiveCyanBrush}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- Vector Canvas Sparkline -->
                    <Grid Grid.Row="1" Height="44" ClipToBounds="True">
                        <!-- Horizontal Gridlines -->
                        <Line X1="0" Y1="11" X2="260" Y2="11" Stroke="#1E293B" StrokeThickness="1" StrokeDashArray="2 3"/>
                        <Line X1="0" Y1="22" X2="260" Y2="22" Stroke="#1E293B" StrokeThickness="1" StrokeDashArray="2 3"/>
                        <Line X1="0" Y1="33" X2="260" Y2="33" Stroke="#1E293B" StrokeThickness="1" StrokeDashArray="2 3"/>

                        <!-- Area Fill Under Curve -->
                        <Polygon Points="{Binding SparklineAreaPoints}">
                            <Polygon.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#4D06B6D4" Offset="0.0"/>
                                    <GradientStop Color="#0506B6D4" Offset="0.8"/>
                                    <GradientStop Color="#00000000" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Polygon.Fill>
                        </Polygon>

                        <!-- High Contrast Vector Stroke -->
                        <Polyline Points="{Binding SparklinePoints}" 
                                  Stroke="{StaticResource ActiveCyanBrush}" 
                                  StrokeThickness="2" 
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 3. BẢNG DANH SÁCH HÀNG ĐỢI ẢO HÓA (VIRTUALIZINGDATAGRID / 60 FPS)          -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2" 
                Style="{StaticResource WorkstationCardStyle}"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header Columns -->
                    <RowDefinition Height="34"/>
                    <!-- Virtualized List Container -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Border Grid.Row="0" 
                        Background="{StaticResource ElevatedPanelBrush}" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="14,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cột 1 -->
                        <TextBlock Grid.Column="0" Text="THUMBNAIL &amp; TIÊU ĐỀ VIDEO" 
                                   FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <!-- Cột 2 -->
                        <TextBlock Grid.Column="1" Text="NỀN TẢNG" 
                                   FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <!-- Cột 3 -->
                        <TextBlock Grid.Column="2" Text="BẢN ĐỒ PHÂN ĐOẠN (CHUNK MAP)" 
                                   FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <!-- Cột 4 -->
                        <TextBlock Grid.Column="3" Text="TỐC ĐỘ &amp; THỜI GIAN CÒN LẠI (ETA)" 
                                   FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                        <!-- Cột 5 -->
                        <TextBlock Grid.Column="4" Text="THAO TÁC" 
                                   FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Virtualized List with Recycling (Đảm bảo 60 FPS mượt mà cho 100+ tác vụ) -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding DownloadQueue}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel">
                    
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="14,8"/>
                            <Setter Property="Background" Value="{StaticResource CardSurfaceBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceActiveBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewmodels:DownloadTaskItemViewModel}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <!-- Cột 1: Thumbnail & Tiêu đề -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Cột 2: Nền tảng -->
                                    <ColumnDefinition Width="100"/>
                                    <!-- Cột 3: Bản đồ phân đoạn (Chunk Visualizer Bar) -->
                                    <ColumnDefinition Width="220"/>
                                    <!-- Cột 4: Tốc độ & ETA -->
                                    <ColumnDefinition Width="180"/>
                                    <!-- Cột 5: Thao tác -->
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <!-- CỘT 1: THUMBNAIL & TIÊU ĐỀ (Bo góc 4px, cắt tối đa 2 dòng) -->
                                <Grid Grid.Column="0" Margin="0,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail Placeholder (Bo góc 4px) -->
                                    <Border Grid.Column="0" 
                                            Width="64" Height="36" 
                                            CornerRadius="4" 
                                            Background="{StaticResource ElevatedPanelBrush}" 
                                            BorderBrush="{StaticResource BorderSubtleBrush}" 
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <!-- Video Aspect ratio indicator -->
                                            <TextBlock Text="🎬" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
                                            <Border Background="#80000000" CornerRadius="2" Padding="2,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2">
                                                <TextBlock Text="HD" FontSize="7" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Title & Direct URL Text (Cắt gọn tối đa 2 dòng) -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Title}" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                                   FontSize="{StaticResource FontSizeSmall}" 
                                                   FontWeight="SemiBold" 
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="34"
                                                   LineHeight="16"/>
                                        <TextBlock Text="{Binding DirectUrl}" 
                                                   Foreground="{StaticResource TextMutedBrush}" 
                                                   FontSize="{StaticResource FontSizeMicro}" 
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   TextTrimming="CharacterEllipsis" 
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- CỘT 2: NỀN TẢNG (Badge nhận diện logo: TikTok, YouTube, Douyin) -->
                                <Border Grid.Column="1" 
                                        Background="{Binding PlatformBadgeBgHex}" 
                                        CornerRadius="4" 
                                        Padding="8,3" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"
                                        BorderThickness="1"
                                        BorderBrush="#3E4866">
                                    <TextBlock Text="{Binding PlatformBadgeText}" 
                                               FontSize="10" 
                                               FontWeight="ExtraBold" 
                                               Foreground="{Binding PlatformBadgeFgHex}"/>
                                </Border>

                                <!-- CỘT 3: BẢN ĐỒ PHÂN ĐOẠN (CHUNK VISUALIZER BAR) -->
                                <!-- Dải 8 khối chữ nhật liền kề nhau thay thế thanh ProgressBar thông thường -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,12,0">
                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="{Binding StatusText}" 
                                                   FontSize="10" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{Binding StatusColorHex}" 
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}" 
                                                   FontSize="10" 
                                                   FontWeight="Bold" 
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- 8 Khối Phân Đoạn HTTP/3 Liền Kề -->
                                    <ItemsControl ItemsSource="{Binding Chunks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" Columns="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewmodels:ChunkVisualizerItem}">
                                                <Border Style="{StaticResource ChunkBlockStyle}"
                                                        Background="{Binding StateColorHex}"
                                                        BorderBrush="{Binding StateBorderColorHex}"
                                                        ToolTip="{Binding TooltipText}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- CỘT 4: TỐC ĐỘ & ETA (Font Monospace: 14.2 MB/s - 00:00:23) -->
                                <TextBlock Grid.Column="3" 
                                           Text="{Binding SpeedAndEtaFormatted}" 
                                           FontFamily="{StaticResource MonoFontFamily}" 
                                           FontSize="11" 
                                           FontWeight="Medium"
                                           Foreground="{StaticResource ActiveCyanBrush}" 
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Right" 
                                           Margin="0,0,14,0"/>

                                <!-- CỘT 5: THAO TÁC (Nút icon Tạm dừng, Hủy, Mở thư mục đích) -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- Nút Tạm Dừng / Tiếp Tục -->
                                    <Button Style="{StaticResource WorkstationButtonStyle}"
                                            ToolTip="Tạm dừng / Tiếp tục tác vụ này"
                                            Padding="6,4"
                                            Margin="0,0,4,0"
                                            Click="OnToggleItemPauseClick">
                                        <TextBlock Text="⏯️" FontSize="11"/>
                                    </Button>

                                    <!-- Nút Mở Thư Mục Đích -->
                                    <Button Style="{StaticResource WorkstationButtonStyle}"
                                            ToolTip="Mở thư mục chứa video tải trong Windows Explorer"
                                            Padding="6,4"
                                            Margin="0,0,4,0"
                                            Click="OnOpenFolderClick">
                                        <TextBlock Text="📂" FontSize="11"/>
                                    </Button>

                                    <!-- Nút Hủy Bỏ Tác Vụ -->
                                    <Button Style="{StaticResource WorkstationButtonStyle}"
                                            ToolTip="Hủy bỏ tác vụ này"
                                            Padding="6,4"
                                            Click="OnCancelItemClick">
                                        <TextBlock Text="❌" FontSize="10" Foreground="{StaticResource ErrorCrimsonBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 4. MICRO STATUS FOOTER                                                    -->
        <!-- ========================================================================= -->
        <Border Grid.Row="3" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Trạng thái: " FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="HÀNG ĐỢI: " FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding TotalQueuedCount}" FontSize="{StaticResource FontSizeMicro}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" Foreground="{StaticResource NeonPurpleBrush}" Margin="0,0,12,0"/>

                    <TextBlock Text="HOÀN TẤT: " FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding CompletedCount}" FontSize="{StaticResource FontSizeMicro}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" Foreground="{StaticResource EmeraldGreenBrush}" Margin="0,0,12,0"/>

                    <TextBlock Text="RECYCLING VIRTUALIZATION @ 60 FPS" FontSize="{StaticResource FontSizeMicro}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" Foreground="{StaticResource EmeraldGreenBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
