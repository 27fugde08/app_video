<UserControl x:Class="CreatorOS.Desktop.Wpf.Views.ContentIdShieldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:CreatorOS.Desktop.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1180"
             Background="#0F172A">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Top Input & Profile Selector Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content: Left Split-Screen Comparison / Right Fine-tuning & Safety Gauge -->
            <RowDefinition Height="*"/>
            <!-- Bottom Export & Status -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Input & Profile Bar -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🛡️ TỆP VIDEO GỐC:" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding SourceVideoPath, UpdateSourceTrigger=PropertyChanged}" 
                         Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1"
                         Padding="8,5" FontSize="11" VerticalContentAlignment="Center"/>

                <!-- Profile Intensity Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                    <RadioButton Content="🟢 Mức Nhẹ (Safe)" IsChecked="{Binding SelectedIntensity, ConverterParameter=Safe}"
                                 Foreground="#34D399" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton Content="🟡 Cân Bằng (Balanced)" IsChecked="{Binding SelectedIntensity, ConverterParameter=Balanced}"
                                 Foreground="#FBBF24" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton Content="🔴 Mức Cao (Aggressive)" IsChecked="{Binding SelectedIntensity, ConverterParameter=Aggressive}"
                                 Foreground="#F87171" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Split-Screen Comparison (Original vs Shielded) -->
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="12"/>
                <!-- Right: Safety Score & Distortion Controls -->
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Split-Screen Comparison -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="◀ Video Gốc (Original)" Foreground="#94A3B8" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="Đã Áp Dụng Shield ▶" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" TextAlignment="Right"/>
                    </Grid>

                    <!-- Split Canvas Preview Container -->
                    <Border Grid.Row="1" Background="#020617" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <!-- Direct3D Split Screen Canvas -->
                            <TextBlock Text="[Direct3D 11 Real-Time A/B Split-Screen Shader Preview]" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                            
                            <!-- Split Line Indicator -->
                            <Line X1="320" Y1="0" X2="320" Y2="500" Stroke="#38BDF8" StrokeThickness="2" StrokeDashArray="2 2"/>
                        </Grid>
                    </Border>

                    <!-- Split Position Slider -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Kéo trượt so sánh A/B:" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider Grid.Column="1" Value="{Binding SplitSliderPosition}" Minimum="0.0" Maximum="1.0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding SplitSliderPosition, StringFormat='{}{0:P0}'}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: Safety Score & Distortion Controls -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="14">
                <StackPanel>
                    <!-- Copyright Safety Gauge -->
                    <Border Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="📊 CHỈ SỐ BẢO VỆ BẢN QUYỀN (SAFETY SCORE)" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                            
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0" Value="{Binding SafetyScore}" Maximum="100" Height="10" Background="#334155" Foreground="#10B981" BorderThickness="0"/>
                                <TextBlock Grid.Column="1" Text="{Binding SafetyScore, StringFormat='{}{0}%'}" Foreground="#10B981" FontWeight="Bold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="Tọa độ pixel và đỉnh phổ âm thanh đã được tản mác an toàn." Foreground="#64748B" FontSize="10"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="🛠️ Các Lớp Can Thiệp Vi Mô (Micro Distortions)" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>

                    <!-- Checkboxes -->
                    <CheckBox Content="Chu kỳ zoom chậm (Ken Burns Breathing 1.02x)" IsChecked="{Binding EnableKenBurnsBreathing}" Foreground="#F8FAFC" FontSize="11" Margin="0,0,0,10"/>
                    <CheckBox Content="Hạt điện ảnh mờ phá vỡ Macroblock (Film Grain)" IsChecked="{Binding EnableFilmGrain}" Foreground="#F8FAFC" FontSize="11" Margin="0,0,0,10"/>
                    <CheckBox Content="Lệch pha &amp; khử đồng bộ âm thanh (Stereo Decoupling)" IsChecked="{Binding EnableStereoDecouple}" Foreground="#F8FAFC" FontSize="11" Margin="0,0,0,10"/>
                    <CheckBox Content="Tần số khung hình động (Dynamic FPS 29.97/30.03)" IsChecked="{Binding EnableDynamicFps}" Foreground="#F8FAFC" FontSize="11" Margin="0,0,0,14"/>

                    <!-- Technical note -->
                    <Border Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Padding="10">
                        <StackPanel>
                            <TextBlock Text="⚡ 1-Pass NVENC GPU Acceleration" Foreground="#FBBF24" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="Toàn bộ chuỗi filtergraph được gộp và render trực tiếp trong 1 pass duy nhất qua bộ mã hóa h264_nvenc không sinh file tạm." Foreground="#94A3B8" FontSize="10" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Export & Status -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,12,0,0" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ProgressBar Value="{Binding ProcessingProgress}" Maximum="100" Height="6" Width="380" HorizontalAlignment="Left"
                                 Background="#334155" Foreground="#38BDF8" BorderThickness="0"
                                 Visibility="{Binding IsProcessing, Converter={x:Static BooleanToVisibilityConverter.Instance}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="🚀 Render Video Với Shield (1-Pass NVENC)" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold"
                        FontSize="13" BorderThickness="0" Padding="18,8" Command="{Binding ApplyShieldAndExportCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
