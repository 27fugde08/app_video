<UserControl x:Class="CreatorOS.Views.InpainterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CreatorOS.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="#0F172A">

    <UserControl.DataContext>
        <vm:InpainterViewModel />
    </UserControl.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Main Studio Canvas & Controls -->
            <RowDefinition Height="Auto"/> <!-- Status & Progress Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Header & Title -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="AI Watermark &amp; Subtitle Eraser" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,12,0"/>
                        <Border Background="#065F46" CornerRadius="12" Padding="8,2" Margin="0,0,8,0">
                            <TextBlock Text="LaMa DirectML 48 FPS" FontSize="11" FontWeight="SemiBold" Foreground="#34D399"/>
                        </Border>
                        <Border Background="#1E3A8A" CornerRadius="12" Padding="8,2">
                            <TextBlock Text="Zero VRAM Leak" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Tự động nhận diện và tẩy xóa phụ đề cứng (Hardcoded Subtitles), logo kênh, watermark dính sẵn bằng AI LaMa / ProPainter DirectML và FFmpeg Delogo siêu tốc."
                               FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Hardware Metric Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0F172A" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="GPU BACKEND" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding HardwareBackendInfo}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0F172A" CornerRadius="8" Padding="12,6" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="VRAM USAGE" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding VramUsageMb, StringFormat='{}{0:F0} MB'}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Studio Canvas (Left: Video Player / Interactive Box Canvas, Right: Configuration Panel) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/> <!-- Video Canvas & A/B Wipe -->
                <ColumnDefinition Width="1*"/> <!-- Settings & ROIs List -->
            </Grid.ColumnDefinitions>

            <!-- Video Player with Interactive Bounding Box Canvas -->
            <Border Grid.Column="0" Background="#020617" CornerRadius="12" Margin="0,0,16,0" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <!-- Simulated Video Frame Image (Original with Chinese yellow hardcoded subtitles) -->
                    <Image Source="pack://application:,,,/Resources/sample_video_frame.jpg" Stretch="UniformToFill" Opacity="0.95"/>

                    <!-- Interactive Bounding Boxes Overlay Canvas -->
                    <Canvas x:Name="RoiCanvas" Background="Transparent" MouseDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove" MouseUp="OnCanvasMouseUp">
                        <!-- Dynamic Bounding Boxes rendered from ViewModel -->
                        <ItemsControl ItemsSource="{Binding ActiveBoundingBoxes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EF4444" BorderThickness="2" Background="#40EF4444" CornerRadius="4"
                                            Width="{Binding Width}" Height="{Binding Height}">
                                        <TextBlock Text="Vùng Tẩy Xóa" FontSize="10" FontWeight="Bold" Foreground="#FCA5A5" Background="#99000000" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </Canvas>

                    <!-- A/B Wipe Comparison Overlay Slider -->
                    <Border Background="#99000000" VerticalAlignment="Bottom" Margin="16" Padding="12" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gốc (Original)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding AbSplitPosition}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Đã Xóa Sạch (Inpainted)" FontSize="11" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Configuration & Bounding Box Manager -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Mode Selector -->
                        <TextBlock Text="CHẾ ĐỘ TẨY XÓA" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                        
                        <RadioButton Content="Tự động quét &amp; xóa phụ đề (AI Auto Subtitle)" 
                                     IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AutoHardcodedSubtitle}"
                                     Foreground="#F8FAFC" FontSize="12" Margin="0,0,0,6"/>
                        
                        <RadioButton Content="Xóa logo tĩnh khoanh vùng (Static Box)" 
                                     IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=StaticWatermarkBox}"
                                     Foreground="#F8FAFC" FontSize="12" Margin="0,0,0,6"/>
                        
                        <RadioButton Content="Xóa siêu tốc không AI (FFmpeg Delogo > 150 FPS)" 
                                     IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=FastDelogoFallback}"
                                     Foreground="#F8FAFC" FontSize="12" Margin="0,0,0,16"/>

                        <!-- Parameters Slider: Dilation -->
                        <TextBlock Text="ĐỘ NỞ VIỀN CHỮ (MASK DILATION)" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="1" Maximum="10" Value="{Binding MaskDilationPx}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding MaskDilationPx, StringFormat='{}{0} px'}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Action Buttons -->
                        <Button Command="{Binding ResetToDefaultSubtitleRoiCommand}" Content="📍 Đặt lại vùng phụ đề đáy (Preset)" 
                                Background="#334155" Foreground="#F8FAFC" FontWeight="SemiBold" Height="36" Margin="0,0,0,8"/>
                        
                        <Button Command="{Binding ClearAllRoisCommand}" Content="🗑 Xóa toàn bộ vùng chọn" 
                                Background="#334155" Foreground="#F8FAFC" FontWeight="SemiBold" Height="36" Margin="0,0,0,16"/>

                        <!-- Start / Cancel Execution -->
                        <Button Command="{Binding StartInpaintingCommand}" Content="⚡ BẮT ĐẦU TẨY XÓA TOÀN BỘ VIDEO" 
                                Background="#10B981" Foreground="#022C22" FontWeight="Bold" FontSize="13" Height="44" Margin="0,0,0,8"/>

                        <Button Command="{Binding CancelInpaintingCommand}" Content="Dừng tác vụ" 
                                Background="#EF4444" Foreground="#FFFFFF" FontWeight="SemiBold" Height="36"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. Status Bar & Progress -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="16,10" Margin="0,16,0,0" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Value="{Binding ProgressPercentage}" Maximum="100" Height="8" Background="#0F172A" Foreground="#10B981"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
