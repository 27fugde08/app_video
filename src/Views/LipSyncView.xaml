<UserControl x:Class="CreatorOS.Desktop.Wpf.Views.LipSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:CreatorOS.Desktop.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1180"
             Background="#0F172A">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Top Input Paths Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content: Left Interactive ROI Canvas / Right Fine-tuning Controls -->
            <RowDefinition Height="*"/>
            <!-- Bottom Export & Status -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Input Paths Bar -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Source Video -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🎥 VIDEO GỐC:" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SourceVideoPath, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1"
                             Padding="8,5" FontSize="11" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="🔍 Quét Khẩu Hình" Command="{Binding TrackFaceAndMouthCommand}"
                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"
                            BorderThickness="0" Padding="14,5" Margin="10,0,0,0"/>
                </Grid>

                <!-- Row 2: Target Audio -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🎙️ AUDIO LỒNG TIẾNG:" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding TargetAudioPath, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1"
                             Padding="8,5" FontSize="11" VerticalContentAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Interactive Face & Mouth ROI Preview Canvas -->
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="12"/>
                <!-- Right: Fine-tuning Sliders & Parameters -->
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: ROI Preview Canvas -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🎯 Căn Chỉnh Vùng Khẩu Hình Tương Tác (Face ROI Box)" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                    <!-- Simulated Canvas with Bounding Box Overlay -->
                    <Border Grid.Row="1" Background="#020617" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <!-- Background Frame Placeholder -->
                            <TextBlock Text="[Direct3D 11 NVDEC Video Stream Frame]" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>

                            <!-- Interactive ROI Bounding Box -->
                            <Canvas>
                                <Rectangle Canvas.Left="220" Canvas.Top="230" Width="140" Height="90"
                                           Stroke="#10B981" StrokeThickness="2" StrokeDashArray="3 2"
                                           Fill="#2010B981"/>
                                <TextBlock Canvas.Left="225" Canvas.Top="235" Text="Vùng Miệng (Mouth ROI)" Foreground="#34D399" FontSize="10" FontWeight="Bold"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- Quick 5s Loop Preview Button -->
                    <Button Grid.Row="2" Content="⚡ Xem Thử 5 Giây Đầu (Preview Loop)" Command="{Binding Preview5SecondsCommand}"
                            Background="#8B5CF6" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"
                            BorderThickness="0" Padding="14,8" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- Right: Fine-tuning Parameters -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="⚙️ Thông Số Hòa Trộn &amp; Khử Rung" Foreground="#34D399" FontWeight="Bold" FontSize="13" Margin="0,0,0,12"/>

                    <!-- Smoothing Strength (One-Euro Filter) -->
                    <TextBlock Text="Độ làm mịn chuyển động (One-Euro Filter):" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Value="{Binding SmoothingStrength}" Minimum="0.1" Maximum="1.0" SmallChange="0.05" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding SmoothingStrength, StringFormat='{}{0:F2}'}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Feather Radius (Gaussian Blur) -->
                    <TextBlock Text="Độ mờ viền mặt nạ (Feathering Radius):" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Value="{Binding FeatherRadius}" Minimum="5" Maximum="35" SmallChange="1" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding FeatherRadius, StringFormat='{}{0}px'}" Foreground="#FCD34D" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Batch Size (VRAM Governor) -->
                    <TextBlock Text="Kích thước Batch GPU (CUDA):" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox SelectedValue="{Binding BatchSize}" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569" Padding="6,4" FontSize="11" Margin="0,0,0,14">
                        <ComboBoxItem Content="8 Khung hình / Lượt (< 4GB VRAM)" Tag="8"/>
                        <ComboBoxItem Content="16 Khung hình / Lượt (Chuẩn RTX)" Tag="16" IsSelected="True"/>
                        <ComboBoxItem Content="32 Khung hình / Lượt (Tối Đa Công Suất)" Tag="32"/>
                    </ComboBox>

                    <!-- Color Correction & Skin Harmony -->
                    <CheckBox Content="Tự động cân bằng màu da (Skin Tone Harmony)" IsChecked="{Binding EnableColorCorrection}" Foreground="#F8FAFC" FontSize="11" Margin="0,0,0,14"/>

                    <!-- Safe Storage Note -->
                    <Border Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Padding="8">
                        <TextBlock Text="💡 Toàn bộ tiến trình xử lý in-memory stream không tạo file frame rác trên ổ cứng." Foreground="#64748B" FontSize="10" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Export & Status -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,12,0,0" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ProgressBar Value="{Binding ProcessingProgress}" Maximum="100" Height="6" Width="380" HorizontalAlignment="Left"
                                 Background="#334155" Foreground="#10B981" BorderThickness="0"
                                 Visibility="{Binding IsProcessing, Converter={x:Static BooleanToVisibilityConverter.Instance}, FallbackValue=Collapsed}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="🚀 Khớp Khẩu Hình &amp; Xuất Video NVENC" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold"
                        FontSize="13" BorderThickness="0" Padding="18,8" Command="{Binding RenderFullLipSyncVideoCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
