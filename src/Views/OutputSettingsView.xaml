<UserControl x:Class="CreatorOS.Desktop.Wpf.Views.OutputSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CreatorOS.Desktop.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Background="#0B0F17" Foreground="#F3F4F6">

    <UserControl.Resources>
        <!-- Style cho Nút Token Nhanh -->
        <Style x:Key="TokenPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="BorderBrush" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho Nút Hành Động Chính -->
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="960" HorizontalAlignment="Stretch">
            
            <!-- Header Module -->
            <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Smart Output Router &amp; Asset Packager" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Tự động phân loại cấu trúc thư mục đa tầng theo biểu thức Token, gom cụm bộ tài nguyên phái sinh và đồng bộ SQLite WAL." 
                                   FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#065F46" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="MFT Atomic Zero-Copy Active" Foreground="#A7F3D0" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Phần 1: Thư Mục Gốc & Mẫu Biểu Thức Token -->
            <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="1. ĐƯỜNG DẪN GỐC &amp; MẪU BIỂU THỨC (TOKEN PATTERN)" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,14"/>

                    <!-- Thư mục gốc -->
                    <TextBlock Text="Thư mục xuất xưởng gốc (BaseDir):" FontSize="12" Foreground="#D1D5DB" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BaseDirectory, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#030712" Foreground="#F9FAFB" BorderBrush="#374151" BorderThickness="1"
                                 Padding="10,8" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Mở Thư Mục" Command="{Binding OpenBaseFolderInExplorerCommand}"
                                Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" BorderThickness="1"
                                Margin="8,0,0,0" Padding="14,8" Cursor="Hand"/>
                    </Grid>

                    <!-- Mẫu đường dẫn Token -->
                    <TextBlock Text="Cú pháp cây thư mục động (Pattern Template):" FontSize="12" Foreground="#D1D5DB" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding PatternTemplate, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#030712" Foreground="#A855F7" BorderBrush="#6B21A8" BorderThickness="1"
                             Padding="10,8" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" Margin="0,0,0,12"/>

                    <!-- Danh sách các nút chèn Token nhanh -->
                    <TextBlock Text="Chèn nhanh Token vào mẫu đường dẫn:" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="+ {BaseDir}" Style="{StaticResource TokenPillButton}" Command="{Binding InsertTokenCommand}" CommandParameter="{}{BaseDir}"/>
                        <Button Content="+ {Platform}" Style="{StaticResource TokenPillButton}" Command="{Binding InsertTokenCommand}" CommandParameter="{}{Platform}"/>
                        <Button Content="+ {Date:yyyy-MM}" Style="{StaticResource TokenPillButton}" Command="{Binding InsertTokenCommand}" CommandParameter="{}{Date:yyyy-MM}"/>
                        <Button Content="+ {Date:yyyy-MM-dd}" Style="{StaticResource TokenPillButton}" Command="{Binding InsertTokenCommand}" CommandParameter="{}{Date:yyyy-MM-dd}"/>
                        <Button Content="+ {Author}" Style="{StaticResource TokenPillButton}" Command="{Binding InsertTokenCommand}" CommandParameter="{}{Author}"/>
                        <Button Content="+ {Genre}" Style="{StaticResource TokenPillButton}" Command="{Binding InsertTokenCommand}" CommandParameter="{}{Genre}"/>
                        <Button Content="+ {Resolution}" Style="{StaticResource TokenPillButton}" Command="{Binding InsertTokenCommand}" CommandParameter="{}{Resolution}"/>
                        <Button Content="+ {Lang}" Style="{StaticResource TokenPillButton}" Command="{Binding InsertTokenCommand}" CommandParameter="{}{Lang}"/>
                        <Button Content="+ {Title}" Style="{StaticResource TokenPillButton}" Command="{Binding InsertTokenCommand}" CommandParameter="{}{Title}"/>
                    </WrapPanel>

                    <!-- Live Path Preview Monospace -->
                    <Border Background="#030712" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="XEM TRƯỚC ĐƯỜNG DẪN THỰC TẾ (LIVE PATH PREVIEW):" FontSize="10" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding LivePreviewPath}" FontSize="12" FontFamily="Consolas" Foreground="#34D399" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Phần 2: Cấu Trúc Self-Contained Bundle & Tùy Chọn Dọn Rác -->
            <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="2. CẤU TRÚC GOM CỤM TÀI NGUYÊN (SELF-CONTAINED BUNDLE) &amp; DỌN RÁC" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,14"/>

                    <!-- Sơ đồ cây thư mục gói sản phẩm -->
                    <Border Background="#030712" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#E5E7EB" LineHeight="18">
                            <Run Text="{Binding LivePreviewPath}" Foreground="#FBBF24" FontWeight="Bold"/><LineBreak/>
                            <Run Text="├── {Video_Title}_Dubbed.mp4        # Video lồng tiếng hoàn chỉnh (NVENC Mux)" Foreground="#38BDF8"/><LineBreak/>
                            <Run Text="├── {Video_Title}_Original.mp4      # Video gốc tải về (tùy chọn lưu trữ)" Foreground="#9CA3AF"/><LineBreak/>
                            <Run Text="├── cover_3d.jpg                    # Ảnh bìa thumbnail 3D nổi khối" Foreground="#EC4899"/><LineBreak/>
                            <Run Text="├── subtitles_vi.srt                # Phụ đề chuẩn nhịp thời gian" Foreground="#10B981"/><LineBreak/>
                            <Run Text="├── subtitles_vi.ass                # Phụ đề karaoke hiệu ứng động" Foreground="#A78BFA"/><LineBreak/>
                            <Run Text="├── script_director.json            # Kịch bản đạo diễn &amp; phân tích xưng hô" Foreground="#F59E0B"/><LineBreak/>
                            <Run Text="└── metadata.json                   # Siêu dữ liệu SEO (Tiêu đề, tags, mô tả)" Foreground="#34D399"/>
                        </TextBlock>
                    </Border>

                    <!-- Checkbox Dọn Rác -->
                    <StackPanel Margin="0,0,0,16">
                        <CheckBox Content="Tự động xóa video gốc sau khi lồng tiếng thành công (Tiết kiệm dung lượng ổ cứng)"
                                  IsChecked="{Binding DeleteOriginalAfterPackaging}"
                                  Foreground="#E5E7EB" FontSize="12" Margin="0,0,0,10"/>
                        <CheckBox Content="Chỉ giữ lại video thành phẩm &amp; thumbnail, tự động xóa toàn bộ Audio Stems trung gian (vocals.wav, bgm.wav)"
                                  IsChecked="{Binding PurgeIntermediateStems}"
                                  Foreground="#E5E7EB" FontSize="12" Margin="0,0,0,10"/>
                    </StackPanel>

                    <!-- Xử lý trùng lặp file -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hành động khi trùng tên file:" FontSize="12" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedCollisionIndex}"
                                  Background="#030712" Foreground="#F9FAFB" BorderBrush="#374151" Padding="8,6">
                            <ComboBoxItem Content="Tự động đánh số thứ tự tăng dần (video_1.mp4)"/>
                            <ComboBoxItem Content="Ghi đè tệp cũ (Overwrite)"/>
                            <ComboBoxItem Content="Bỏ qua tệp (Skip)"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Nút Lưu Cấu Hình & Chạy Mô Phỏng -->
            <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Khôi Phục Mặc Định" Command="{Binding ResetToDefaultPatternCommand}"
                                Background="#1F2937" Foreground="#9CA3AF" BorderBrush="#374151" BorderThickness="1"
                                Margin="0,0,10,0" Padding="14,8" Cursor="Hand"/>
                        <Button Content="Mô Phỏng Đóng Gói Bundle" Command="{Binding SimulatePackageCommand}"
                                Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0"
                                Margin="0,0,10,0" Padding="16,8" Cursor="Hand" FontWeight="Bold"/>
                        <Button Content="Lưu Cấu Hình Router" Command="{Binding SaveSettingsCommand}"
                                Style="{StaticResource PrimaryActionButton}"/>
                    </WrapPanel>

                    <!-- Status Message & Simulation Output -->
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#A78BFA" Margin="0,12,0,0" FontWeight="SemiBold"/>
                    
                    <Border Background="#030712" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0"
                            Visibility="{Binding LastPackagedResultSummary, Converter={x:Null}}">
                        <TextBlock Text="{Binding LastPackagedResultSummary}" FontFamily="Consolas" FontSize="11" Foreground="#38BDF8" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
